<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="BikeMate.AdminShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:admin="clr-namespace:BikeMate.Views.Admin"
    Title="Admin"
    Shell.NavBarIsVisible="False">

    <TabBar Route="AdminArea">
        <ShellContent Title="Dashboard" Route="AdminDashboardPage" ContentTemplate="{DataTemplate admin:AdminDashboardPage}" />
        <ShellContent Title="Emergency" Route="AdminEmergencyRequestsPage" ContentTemplate="{DataTemplate admin:AdminEmergencyRequestsPage}" />
        <ShellContent Title="Requests" Route="AdminRequestsPage" ContentTemplate="{DataTemplate admin:AdminRequestsPage}" />
        <ShellContent Title="Reports" Route="AdminReportsPage" ContentTemplate="{DataTemplate admin:AdminReportsPage}" />
        <ShellContent Title="Audit" Route="AdminAuditLogsPage" ContentTemplate="{DataTemplate admin:AdminAuditLogsPage}" />
    </TabBar>
</Shell>
