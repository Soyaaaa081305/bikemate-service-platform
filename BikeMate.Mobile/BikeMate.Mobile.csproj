<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>BikeMate</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>BikeMate</ApplicationTitle>
		<ApplicationId>com.bikemate.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<Platforms>AnyCPU</Platforms>
		<NoWarn>$(NoWarn);NU1608</NoWarn>
		<BikeMateApiBaseUrl Condition="'$(BikeMateApiBaseUrl)' == ''">https://bikemate-api-afaolandez.azurewebsites.net/api/</BikeMateApiBaseUrl>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Keep Debug attachable, but avoid Fast Deployment's stale asset/override path on emulators. -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\bikemate_appicon.png" Color="#FF6B00" />
		<MauiSplashScreen Include="Resources\AppIcon\bikemate_appicon.png" Color="#FF6B00" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\bikemate_logo.png" />
		<MauiImage Include="Resources\Images\bike_wrench.png" />
		<MauiImage Include="Resources\Images\google_logo.svg" />
		<MauiImage Include="Resources\Images\location_pin.svg" />
		<MauiImage Include="Resources\Images\mechanic_door.png" />
		<MauiImage Include="Resources\Images\running_man.png" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\BikeMate.Core\BikeMate.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
	    <_Parameter1>BikeMateApiBaseUrl</_Parameter1>
	    <_Parameter2>$(BikeMateApiBaseUrl)</_Parameter2>
	  </AssemblyAttribute>
	</ItemGroup>

</Project>
