<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Navy">#22303D</Color>
    <Color x:Key="NavySoft">#2B3E4E</Color>
    <Color x:Key="Orange">#FF6B00</Color>
    <Color x:Key="OrangeDark">#C45500</Color>
    <Color x:Key="PageBg">#F6F7F9</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="TextDark">#242424</Color>
    <Color x:Key="MutedText">#6E6E6E</Color>
    <Color x:Key="LineColor">#E1E5EA</Color>

    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="Red">#DC2626</Color>
    <Color x:Key="Blue">#2563EB</Color>
    <Color x:Key="Violet">#7C3AED</Color>
    <Color x:Key="Yellow">#CA8A04</Color>
    <Color x:Key="SoftOrange">#FFF3EA</Color>
    <Color x:Key="SoftGreen">#F0FDF4</Color>
    <Color x:Key="SoftBlue">#EFF6FF</Color>
    <Color x:Key="SoftRed">#FEF2F2</Color>
    <Color x:Key="SoftViolet">#F5F3FF</Color>
    <Color x:Key="SoftYellow">#FEFCE8</Color>
    <Color x:Key="SoftGray">#F9FAFB</Color>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        <Setter Property="FontFamily" Value="PTSansCaptionBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="PublicSans" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="SmallMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        <Setter Property="FontFamily" Value="PTSansCaption" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="0" />
    </Style>

</ResourceDictionary>
