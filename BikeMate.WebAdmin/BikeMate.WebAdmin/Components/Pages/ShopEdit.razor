@page "/shops/edit/{Id:int}"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Admin - Edit Shop</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Edit Shop</h1>
            <p class="admin-page-description">Update the official shop profile, verification status, location, and submitted file references.</p>
        </div>
        <div class="admin-page-actions">
            <a href="/shops/details/@Id" class="btn btn-outline-primary shadow-sm">
                <i class="bi bi-eye me-1"></i> View details
            </a>
            <a href="/shops" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

    @if (model == null)
    {
        <div class="empty-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 mb-0">Loading shop record...</p>
        </div>
    }
    else
    {
        <div class="card admin-form-card">
            <div class="card-body p-4">
                <form @onsubmit="SaveShop" @onsubmit:preventDefault>
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Shop name</label>
                            <input class="form-control" @bind="model.ShopName" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Status</label>
                            <select class="form-select" @bind="model.ShopStatus">
                                <option value="pending">Pending</option>
                                <option value="verified">Verified</option>
                                <option value="suspended">Suspended</option>
                                <option value="rejected">Rejected</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Address line</label>
                            <input class="form-control" @bind="model.AddressLine" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">City</label>
                            <input class="form-control" @bind="model.City" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-semibold">Province</label>
                            <input class="form-control" @bind="model.Province" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Contact number</label>
                            <input class="form-control" @bind="model.ContactNumber" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Latitude</label>
                            <InputNumber class="form-control" @bind-Value="model.Latitude" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Longitude</label>
                            <InputNumber class="form-control" @bind-Value="model.Longitude" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">DTI registration number</label>
                            <input class="form-control" @bind="model.DtiRegistrationNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Business permit URL</label>
                            <input class="form-control" @bind="model.BusinessPermitUrl" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cover photo / shop image URL</label>
                            <input class="form-control" @bind="model.ShopImageUrl" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Shop logo URL</label>
                            <input class="form-control" @bind="model.ShopLogoUrl" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Owner valid ID URL</label>
                            <input class="form-control" @bind="model.OwnerValidIdUrl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" rows="5" @bind="model.ShopDescription"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mt-4 flex-wrap">
                        <button type="button" class="btn btn-outline-danger" disabled="@isDeleting" @onclick="DeleteShop">
                            @if (isDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            }
                            Delete shop
                        </button>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSaving">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Save shop
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ShopEditDto? model;
    private string? statusMessage;
    private string statusType = "danger";
    private bool isSaving;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model = await AdminApi.GetShopForEditAsync(Id);
            if (model == null)
            {
                statusMessage = AdminApi.LastError ?? "Shop not found.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task SaveShop()
    {
        if (model == null) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Save changes to {model.ShopName}?");
        if (!confirmed) return;

        try
        {
            isSaving = true;
            statusMessage = null;
            await AdminApi.UpdateShopAsync(Id, model);
            statusType = "success";
            statusMessage = "Shop updated successfully.";
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteShop()
    {
        if (model == null) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete {model.ShopName}? This disables its services, products, and mechanic assignments.");
        if (!confirmed) return;

        try
        {
            isDeleting = true;
            await AdminApi.DeleteShopAsync(Id);
            Navigation.NavigateTo("/shops");
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/shops/details/{Id}");
    }
}
