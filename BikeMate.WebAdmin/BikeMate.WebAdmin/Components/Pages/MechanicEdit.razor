@page "/mechanics/create"
@page "/mechanics/edit/{Id:int}"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(IsCreate ? "Admin - Create Mechanic" : "Admin - Edit Mechanic")</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">@(IsCreate ? "Create Mechanic" : "Edit Mechanic")</h1>
            <p class="admin-page-description">Manage mechanic account access, verification, profile details, documents, and shop assignment.</p>
        </div>
        <div class="admin-page-actions">
            @if (!IsCreate)
            {
                <a href="/mechanics/details/@Id" class="btn btn-outline-primary shadow-sm">
                    <i class="bi bi-eye me-1"></i> View details
                </a>
            }
            <a href="/mechanics" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

    @if (model == null)
    {
        <div class="empty-state">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 mb-0">Loading mechanic form...</p>
        </div>
    }
    else
    {
        <div class="card admin-form-card">
            <div class="card-body p-4">
                <form @onsubmit="SaveMechanic" @onsubmit:preventDefault>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">First name</label>
                            <input class="form-control" @bind="model.FirstName" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Middle name</label>
                            <input class="form-control" @bind="model.MiddleName" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Last name</label>
                            <input class="form-control" @bind="model.LastName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email address</label>
                            <input class="form-control" type="email" @bind="model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone number</label>
                            <input class="form-control" @bind="model.PhoneNumber" placeholder="+63..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@(IsCreate ? "Password" : "New password")</label>
                            <input class="form-control" type="password" @bind="model.Password" minlength="8" required="@IsCreate" />
                            <div class="form-text">Use at least 8 characters. Leave blank when editing to keep the current password.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Confirm password</label>
                            <input class="form-control" type="password" @bind="model.ConfirmPassword" minlength="8" required="@IsCreate" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Account status</label>
                            <select class="form-select" @bind="model.AccountStatus">
                                <option value="pending">Pending</option>
                                <option value="active">Active</option>
                                <option value="suspended">Suspended</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Availability</label>
                            <select class="form-select" @bind="model.AvailabilityStatus">
                                <option value="offline">Offline</option>
                                <option value="online">Online</option>
                                <option value="busy">Busy</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Sex</label>
                            <select class="form-select" @bind="model.Sex">
                                <option value="">Not specified</option>
                                <option value="Female">Female</option>
                                <option value="Male">Male</option>
                                <option value="Prefer not to say">Prefer not to say</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Birthdate</label>
                            <InputDate class="form-control" @bind-Value="model.Birthdate" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Years experience</label>
                            <InputNumber class="form-control" @bind-Value="model.YearsExperience" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Assigned shop</label>
                            <select class="form-select" @bind="model.ShopId">
                                <option value="">Independent / No shop</option>
                                @foreach (var shop in shopOptions)
                                {
                                    <option value="@shop.ShopId">@shop.ShopName (@shop.City, @shop.Status)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="emailVerified" @bind="model.EmailVerified" />
                                <label class="form-check-label" for="emailVerified">Email verified</label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="isVerified" @bind="model.IsVerified" />
                                <label class="form-check-label" for="isVerified">Mechanic approved</label>
                            </div>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="assignmentActive" @bind="model.AssignmentActive" disabled="@(model.ShopId is null)" />
                                <label class="form-check-label" for="assignmentActive">Shop assignment active</label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Address line</label>
                            <input class="form-control" @bind="model.AddressLine" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Barangay</label>
                            <input class="form-control" @bind="model.Barangay" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Zip code</label>
                            <input class="form-control" @bind="model.ZipCode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">City</label>
                            <input class="form-control" @bind="model.City" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Province</label>
                            <input class="form-control" @bind="model.Province" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Profile image URL</label>
                            <input class="form-control" @bind="model.ProfileImageUrl" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Valid ID URL</label>
                            <input class="form-control" @bind="model.ValidIdImageUrl" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Certification/license URL</label>
                            <input class="form-control" @bind="model.CertificationImageUrl" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Bio</label>
                            <textarea class="form-control" rows="4" @bind="model.Bio"></textarea>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between gap-2 mt-4 flex-wrap">
                        @if (!IsCreate)
                        {
                            <button type="button" class="btn btn-outline-danger" disabled="@isDeleting" @onclick="DeleteMechanic">
                                @if (isDeleting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                Delete mechanic
                            </button>
                        }
                        else
                        {
                            <span></span>
                        }
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSaving">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4" disabled="@isSaving">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                }
                                @(IsCreate ? "Create mechanic" : "Save mechanic")
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool IsCreate => Id == 0;
    private MechanicEditDto? model;
    private ShopOptionDto[] shopOptions = [];
    private string? statusMessage;
    private string statusType = "danger";
    private bool isSaving;
    private bool isDeleting;

    protected override async Task OnInitializedAsync()
    {
        shopOptions = await AdminApi.GetShopOptionsAsync();

        if (IsCreate)
        {
            model = new MechanicEditDto();
            return;
        }

        try
        {
            model = await AdminApi.GetMechanicForEditAsync(Id);
            if (model == null)
            {
                statusMessage = AdminApi.LastError ?? "Mechanic not found.";
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
        }
    }

    private async Task SaveMechanic()
    {
        if (model == null) return;

        var name = $"{model.FirstName} {model.LastName}".Trim();
        var action = IsCreate ? "Create" : "Save changes to";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"{action} {(string.IsNullOrWhiteSpace(name) ? "this mechanic" : name)}?");
        if (!confirmed) return;

        try
        {
            isSaving = true;
            statusMessage = null;

            if (model.ShopId is null)
            {
                model.AssignmentActive = false;
            }

            if (IsCreate)
            {
                var created = await AdminApi.CreateMechanicAsync(model);
                Navigation.NavigateTo($"/mechanics/edit/{created.MechanicId}");
                return;
            }

            await AdminApi.UpdateMechanicAsync(Id, model);
            statusType = "success";
            statusMessage = "Mechanic updated successfully.";
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteMechanic()
    {
        if (model == null || IsCreate) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete {model.FirstName} {model.LastName}'s mechanic account? Existing service records remain for reporting.");
        if (!confirmed) return;

        try
        {
            isDeleting = true;
            await AdminApi.DeleteMechanicAsync(Id);
            Navigation.NavigateTo("/mechanics");
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(IsCreate ? "/mechanics" : $"/mechanics/details/{Id}");
    }
}
