@page "/shops/register"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Admin - Register Shop</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Register Shop</h1>
            <p class="admin-page-description">Create an official shop record, then review it through the same approval process used by MAUI applications.</p>
        </div>
        <div class="admin-page-actions">
            <a href="/shops" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

@if (savedShop is not null)
{
    <div class="card border-top border-success border-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h2 class="admin-page-title mb-1">Shop record saved</h2>
                    <p class="text-muted mb-2">Review the application in Approvals before the shop can accept bookings.</p>
                    <span class="badge bg-warning text-dark">@savedShop.ShopStatus.ToUpper()</span>
                </div>
                <a class="btn btn-success" href="/shops/details/@savedShop.ShopId">
                    Open shop profile
                </a>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-body p-4">
        <form @onsubmit="RegisterShop" @onsubmit:preventDefault>
            <div class="row g-4">
                <div class="col-lg-6">
                    <label class="form-label fw-semibold">Shop name</label>
                    <input class="form-control" @bind="newShop.ShopName" placeholder="BikeMate Partner Shop" required />
                </div>
                <div class="col-lg-6">
                    <label class="form-label fw-semibold">Owner / manager name</label>
                    <input class="form-control" @bind="newShop.OwnerName" placeholder="Juan Dela Cruz" required />
                </div>
                <div class="col-lg-8">
                    <label class="form-label fw-semibold">Address</label>
                    <input class="form-control" @bind="newShop.AddressLine" placeholder="Street, barangay, building" required />
                </div>
                <div class="col-lg-2">
                    <label class="form-label fw-semibold">City</label>
                    <input class="form-control" @bind="newShop.City" placeholder="San Pedro" required />
                </div>
                <div class="col-lg-2">
                    <label class="form-label fw-semibold">Province</label>
                    <input class="form-control" @bind="newShop.Province" placeholder="Laguna" required />
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">Contact number</label>
                    <input class="form-control" @bind="newShop.ContactNumber" placeholder="+63..." />
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">DTI registration number</label>
                    <input class="form-control" @bind="newShop.DtiRegistrationNumber" placeholder="Required for shop approval" required />
                </div>
                <div class="col-lg-4">
                    <label class="form-label fw-semibold">Business permit URL / reference</label>
                    <input class="form-control" @bind="newShop.BusinessPermitUrl" placeholder="Uploaded file URL or permit reference" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Description</label>
                    <textarea class="form-control" rows="4" @bind="newShop.ShopDescription" placeholder="Short shop profile, specialties, service notes"></textarea>
                </div>
                <div class="col-12">
                    <div class="alert alert-warning mb-0">
                        <strong>Approval note:</strong> shop owners submit their details, documents, and OTP verification before approval.
                        Admin approval activates the account and moves the shop into the verified partner list.
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSaving">Cancel</button>
                <button type="submit" class="btn btn-primary px-4" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    Register shop
                </button>
            </div>
        </form>
    </div>
</div>
</div>

@code {
    private readonly ShopRegistrationInputDto newShop = new();
    private ShopApprovalResultDto? savedShop;
    private string? statusMessage;
    private string statusType = "danger";
    private bool isSaving;

    private async Task RegisterShop()
    {
        var shopName = string.IsNullOrWhiteSpace(newShop.ShopName) ? "this shop" : newShop.ShopName.Trim();
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Register {shopName} for admin review?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            isSaving = true;
            statusMessage = null;
            savedShop = await AdminApi.CreateShopAsync(newShop);
            statusType = "success";
            statusMessage = "Shop was registered for approval. Approve it from the Approvals page after reviewing the submitted details.";
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/shops");
    }
}
