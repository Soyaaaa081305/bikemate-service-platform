@page "/admin-accounts"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject IJSRuntime JS

<PageTitle>Admin - System Accounts</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Admin Accounts</h1>
            <p class="admin-page-description">Create, update, suspend, and remove system administrator access.</p>
        </div>

        <div class="admin-page-actions">
            <div class="input-group admin-search shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Search admins" @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

    <div class="row g-4">
        <div class="col-xl-7">
            <div class="card admin-table-card h-100">
                <div class="card-header bg-white border-bottom">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h5 fw-bold mb-1">System Administrators</h2>
                            <p class="text-muted mb-0 small">Only active accounts can sign in to the admin portal.</p>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="LoadAdmins" disabled="@isBusy">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (admins == null)
                    {
                        <div class="empty-state">
                            <div class="spinner-border text-info" role="status"></div>
                            <p class="mt-2 mb-0">Loading admin accounts...</p>
                        </div>
                    }
                    else if (!FilteredAdmins.Any())
                    {
                        <div class="empty-state">No admin accounts match the current search.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-muted text-uppercase">
                                    <tr>
                                        <th class="ps-4">Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th class="text-end pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var admin in FilteredAdmins)
                                    {
                                        <tr class="@(editingId == admin.UserId ? "table-primary" : null)">
                                            <td class="ps-4 fw-semibold">@FullName(admin)</td>
                                            <td>@admin.Email</td>
                                            <td>
                                                <span class="@StatusBadgeClass(admin.AccountStatus)">@LabelStatus(admin.AccountStatus)</span>
                                            </td>
                                            <td class="text-muted small">@admin.CreatedAt.ToString("MMM dd, yyyy")</td>
                                            <td class="text-end pe-4">
                                                <div class="btn-group btn-group-sm" role="group" aria-label="Admin account actions">
                                                    <button type="button" class="btn btn-outline-success" @onclick="() => SendCode(admin)" disabled="@(isBusy || !IsActive(admin))">Send code</button>
                                                    <button type="button" class="btn btn-outline-primary" @onclick="() => SelectAdmin(admin.UserId)" disabled="@isBusy">Edit</button>
                                                    <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteAdmin(admin)" disabled="@isBusy">Delete</button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom">
                    <h2 class="h5 fw-bold mb-1">Create Admin</h2>
                    <p class="text-muted mb-0 small">Use this only for trusted BikeMate operations staff.</p>
                </div>
                <div class="card-body">
                    <EditForm Model="@createModel" OnSubmit="@CreateAdmin">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">First name</label>
                                <input class="form-control" @bind="createModel.FirstName" autocomplete="given-name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Last name</label>
                                <input class="form-control" @bind="createModel.LastName" autocomplete="family-name" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Email address</label>
                                <input class="form-control" type="email" @bind="createModel.Email" autocomplete="email" placeholder="admin@example.com" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Phone number</label>
                                <input class="form-control" @bind="createModel.PhoneNumber" autocomplete="tel" placeholder="+63..." />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Password</label>
                                <input class="form-control" type="password" @bind="createModel.Password" autocomplete="new-password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Confirm password</label>
                                <input class="form-control" type="password" @bind="createModel.ConfirmPassword" autocomplete="new-password" />
                                <div class="form-text">Use at least 8 characters.</div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4" disabled="@isBusy">
                            <i class="bi bi-person-plus me-1"></i> Create admin account
                        </button>
                    </EditForm>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h2 class="h5 fw-bold mb-1">Edit Admin</h2>
                    <p class="text-muted mb-0 small">Email is locked. Use a new account if the email must change.</p>
                </div>
                <div class="card-body">
                    @if (editModel == null)
                    {
                        <div class="empty-state py-4">Select an admin account to update.</div>
                    }
                    else
                    {
                        <EditForm Model="@editModel" OnSubmit="@SaveAdmin">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">First name</label>
                                    <input class="form-control" @bind="editModel.FirstName" autocomplete="given-name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Last name</label>
                                    <input class="form-control" @bind="editModel.LastName" autocomplete="family-name" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold">Email address</label>
                                    <input class="form-control" value="@editModel.Email" readonly />
                                </div>
                                <div class="col-md-7">
                                    <label class="form-label fw-semibold">Phone number</label>
                                    <input class="form-control" @bind="editModel.PhoneNumber" autocomplete="tel" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold">Status</label>
                                    <select class="form-select" @bind="editModel.AccountStatus">
                                        <option value="active">Active</option>
                                        <option value="suspended">Suspended</option>
                                        <option value="pending">Pending</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">New password</label>
                                    <input class="form-control" type="password" @bind="editModel.NewPassword" autocomplete="new-password" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Confirm new password</label>
                                    <input class="form-control" type="password" @bind="editModel.ConfirmPassword" autocomplete="new-password" />
                                    <div class="form-text">Leave blank to keep the current password.</div>
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="submit" class="btn btn-primary flex-fill" disabled="@isBusy">
                                    <i class="bi bi-save me-1"></i> Save changes
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@isBusy">Cancel</button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private AdminAccountDto[]? admins;
    private AdminAccountCreateDto createModel = new();
    private AdminAccountEditDto? editModel;
    private int? editingId;
    private string searchTerm = string.Empty;
    private string? statusMessage;
    private string statusType = "danger";
    private bool isBusy;

    private IEnumerable<AdminAccountDto> FilteredAdmins
    {
        get
        {
            var source = admins ?? Array.Empty<AdminAccountDto>();
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                return source;
            }

            return source.Where(admin =>
                FullName(admin).Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                admin.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAdmins();
    }

    private async Task LoadAdmins()
    {
        try
        {
            admins = (await AdminApi.GetAdminAccountsAsync()) ?? Array.Empty<AdminAccountDto>();
            statusMessage = AdminApi.LastError;
            statusType = string.IsNullOrWhiteSpace(statusMessage) ? statusType : "danger";
        }
        catch (Exception ex)
        {
            admins = Array.Empty<AdminAccountDto>();
            statusType = "danger";
            statusMessage = ex.Message;
        }
    }

    private async Task CreateAdmin()
    {
        var email = string.IsNullOrWhiteSpace(createModel.Email) ? "this admin" : createModel.Email.Trim();
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Create a new system admin account for {email} and send a login code?");
        if (!confirmed)
        {
            return;
        }

        isBusy = true;
        try
        {
            var created = await AdminApi.CreateAdminAccountAsync(createModel);
            createModel = new();
            try
            {
                await AdminApi.SendAdminLoginCodeAsync(created.UserId);
                statusType = "success";
                statusMessage = $"Admin account created for {created.Email}. A login code was sent to their email.";
            }
            catch (Exception emailEx)
            {
                statusType = "warning";
                statusMessage = $"Admin account created for {created.Email}, but the login code email was not sent: {emailEx.Message}";
            }

            await LoadAdmins();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SendCode(AdminAccountDto admin)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Send a fresh admin login code to {admin.Email}?");
        if (!confirmed)
        {
            return;
        }

        isBusy = true;
        try
        {
            await AdminApi.SendAdminLoginCodeAsync(admin.UserId);
            statusType = "success";
            statusMessage = $"A fresh admin login code was sent to {admin.Email}.";
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SelectAdmin(int id)
    {
        isBusy = true;
        try
        {
            editModel = await AdminApi.GetAdminAccountForEditAsync(id);
            editingId = editModel?.UserId;
            statusMessage = AdminApi.LastError;
            statusType = string.IsNullOrWhiteSpace(statusMessage) ? "success" : "danger";
        }
        catch (Exception ex)
        {
            editModel = null;
            editingId = null;
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAdmin()
    {
        if (editModel == null)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Save admin account changes for {editModel.Email}?");
        if (!confirmed)
        {
            return;
        }

        isBusy = true;
        try
        {
            await AdminApi.UpdateAdminAccountAsync(editModel.UserId, editModel);
            editModel.NewPassword = null;
            editModel.ConfirmPassword = null;
            statusType = "success";
            statusMessage = "Admin account updated.";
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteAdmin(AdminAccountDto admin)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete admin account for {admin.Email}? At least one active admin must remain.");
        if (!confirmed)
        {
            return;
        }

        isBusy = true;
        try
        {
            await AdminApi.DeleteAdminAccountAsync(admin.UserId);
            if (editingId == admin.UserId)
            {
                CancelEdit();
            }

            statusType = "success";
            statusMessage = $"Admin account {admin.Email} was deleted.";
            await LoadAdmins();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CancelEdit()
    {
        editModel = null;
        editingId = null;
    }

    private static string FullName(AdminAccountDto admin)
    {
        var name = $"{admin.FirstName} {admin.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? "Unnamed admin" : name;
    }

    private static string LabelStatus(string status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "Unknown"
            : char.ToUpperInvariant(status[0]) + status[1..].ToLowerInvariant();
    }

    private static bool IsActive(AdminAccountDto admin)
    {
        return string.Equals(admin.AccountStatus, "active", StringComparison.OrdinalIgnoreCase);
    }

    private static string StatusBadgeClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "active" => "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill",
            "suspended" => "badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill",
            "pending" => "badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill text-dark",
            _ => "badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill"
        };
    }
}
