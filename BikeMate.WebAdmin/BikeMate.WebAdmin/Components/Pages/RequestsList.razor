@page "/requests"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi

<PageTitle>Active Services</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Active Services</h1>
            <p class="admin-page-description">Track booked repairs that still need assignment, payment confirmation, or completion.</p>
        </div>

        <div class="admin-page-actions">
            <div class="input-group admin-search shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Search services"
                       @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <div class="card admin-table-card">
        <div class="card-body p-0">
            @if (requests == null)
            {
                <div class="empty-state">
                    <div class="spinner-border text-warning" role="status"></div>
                    <p class="mt-2 mb-0">Loading active services...</p>
                </div>
            }
            else if (requests.Length == 0)
            {
                <div class="empty-state">No active service requests at this time.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-4">Request ID</th>
                                <th>Customer</th>
                                <th>Service</th>
                                <th>Status</th>
                                <th>Amount</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in FilteredRequests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@req.Id</td>
                                    <td class="fw-semibold">@req.ClientName</td>
                                    <td>@req.ServiceName</td>
                                    <td>
                                        @if (req.Status.ToLower() == "in progress")
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 text-dark">In progress</span>
                                        }
                                        else if (req.Status.ToLower() == "pending")
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">@req.Status.Replace("_", " ")</span>
                                        }
                                    </td>
                                    <td class="text-success fw-bold">PHP @req.TotalAmount.ToString("N2")</td>
                                    <td class="text-end pe-4">
                                        <a href="/requests/details/@req.Id" class="btn btn-sm btn-outline-primary shadow-sm">View details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ServiceRequestDto[]? requests;
    private string searchTerm = "";

    private IEnumerable<ServiceRequestDto> FilteredRequests => string.IsNullOrWhiteSpace(searchTerm)
        ? requests ?? Array.Empty<ServiceRequestDto>()
        : requests!.Where(r => r.ClientName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               r.ServiceName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                               r.Id.ToString() == searchTerm);

    protected override async Task OnInitializedAsync()
    {
        requests = await AdminApi.GetActiveRequestsAsync();
    }
}
