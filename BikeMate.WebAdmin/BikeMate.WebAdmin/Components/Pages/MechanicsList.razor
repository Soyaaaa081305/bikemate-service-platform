@page "/mechanics"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject IJSRuntime JS

<PageTitle>Admin - Mechanic Directory</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Mechanic Directory</h1>
            <p class="admin-page-description">Monitor mechanic availability, ratings, and completed work across partner shops.</p>
        </div>
        <div class="admin-page-actions">
            <a href="/mechanics/create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Create mechanic
            </a>
            <div class="input-group admin-search shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Search mechanics"
                       @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <div class="card admin-table-card">
        <div class="card-body p-0">
            @if (mechanics == null)
            {
                <div class="empty-state">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2 mb-0">Loading mechanics...</p>
                </div>
            }
            else if (mechanics.Length == 0)
            {
                <div class="empty-state">No mechanics found in the system.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Name</th>
                                <th>Shop</th>
                                <th>Rating</th>
                                <th>Total jobs</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mechanic in FilteredMechanics)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@mechanic.Id</td>
                                    <td>
                                        <div class="fw-semibold">@mechanic.Name</div>
                                        <div class="small text-muted">@mechanic.Email</div>
                                    </td>
                                    <td>@mechanic.ShopName</td>
                                    <td>@((mechanic.Rating ?? 0m).ToString("0.0"))</td>
                                    <td>@mechanic.TotalJobs</td>
                                    <td>
                                        <span class="@MechanicStatusBadgeClass(mechanic.Status)">@LabelStatus(mechanic.Status)</span>
                                        <span class="@AccountStatusBadgeClass(mechanic.AccountStatus)">@LabelStatus(mechanic.AccountStatus)</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Mechanic actions">
                                            <a href="/mechanics/details/@mechanic.Id" class="btn btn-outline-primary shadow-sm">View</a>
                                            <a href="/mechanics/edit/@mechanic.Id" class="btn btn-outline-secondary shadow-sm">Edit</a>
                                            <button type="button" class="btn btn-outline-warning shadow-sm" @onclick="() => SuspendMechanic(mechanic)">Suspend</button>
                                            <button type="button" class="btn btn-outline-danger shadow-sm" @onclick="() => DeleteMechanic(mechanic)">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />
</div>

@code {
    private BikeMate.WebAdmin.DTOs.MechanicDto[]? mechanics;
    private string searchTerm = "";
    private string? statusMessage;
    private string statusType = "danger";

    private IEnumerable<MechanicDto> FilteredMechanics => string.IsNullOrWhiteSpace(searchTerm)
        ? mechanics ?? Array.Empty<MechanicDto>()
        : mechanics!.Where(m => m.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                m.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                                m.ShopName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadMechanics();
    }

    private async Task LoadMechanics()
    {
        var fetchedMechanics = await AdminApi.GetMechanicsAsync();
        if (fetchedMechanics != null)
        {
            mechanics = fetchedMechanics
                .OrderByDescending(m => m.Status.ToLower() == "online")
                .ThenBy(m => m.Name)
                .ToArray();
        }

        if (!string.IsNullOrWhiteSpace(AdminApi.LastError))
        {
            statusType = "danger";
            statusMessage = AdminApi.LastError;
        }
    }

    private async Task SuspendMechanic(MechanicDto mechanic)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Suspend {mechanic.Name}?");
        if (!confirmed) return;

        try
        {
            await AdminApi.SuspendMechanicAsync(mechanic.Id);
            statusType = "success";
            statusMessage = $"{mechanic.Name} was suspended.";
            await LoadMechanics();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
    }

    private async Task DeleteMechanic(MechanicDto mechanic)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {mechanic.Name}'s mechanic account?");
        if (!confirmed) return;

        try
        {
            await AdminApi.DeleteMechanicAsync(mechanic.Id);
            statusType = "success";
            statusMessage = $"{mechanic.Name} was deleted.";
            await LoadMechanics();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
    }

    private static string LabelStatus(string status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "Unknown"
            : char.ToUpperInvariant(status[0]) + status[1..].ToLowerInvariant();
    }

    private static string MechanicStatusBadgeClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "online" => "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-1",
            "busy" => "badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 text-dark me-1",
            _ => "badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 me-1"
        };
    }

    private static string AccountStatusBadgeClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "active" => "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25",
            "pending" => "badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 text-dark",
            "suspended" => "badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
            _ => "badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"
        };
    }
}
