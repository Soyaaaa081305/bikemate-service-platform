@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>BikeMate Admin | Login</PageTitle>

<div class="auth-shell">
    <div class="card auth-card shadow-lg">
        <div class="card-body p-4 p-md-5">

            <div class="text-center mb-4">
                <img src="/Images/bikematelogo.png" alt="BikeMate Logo" class="auth-logo mb-3" />
                <h1 class="auth-title">Admin Portal</h1>
                <p class="auth-copy">Authorized personnel only</p>
            </div>

            @if (Navigation.Uri.Contains("error=db"))
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 text-white border-danger border-opacity-50 text-center" role="alert">
                    Unable to connect to the BikeMate database. Check that SQL Server is running and try again.
                </div>
            }
            else if (Navigation.Uri.Contains("error=true"))
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 text-white border-danger border-opacity-50 text-center" role="alert">
                    Invalid email or password.
                </div>
            }

            <form method="post" action="/api/admin/cookie-login">
                <div class="auth-field mb-3">
                    <label class="auth-label" for="emailInput">Email Address</label>
                    <input type="email"
                           name="email"
                           class="auth-input"
                           id="emailInput"
                           placeholder="admin1@bikemate.test"
                           autocomplete="username"
                           required />
                </div>

                <div class="auth-field mb-4">
                    <label class="auth-label" for="passwordInput">Password</label>
                    <input type="password"
                           name="password"
                           class="auth-input"
                           id="passwordInput"
                           placeholder="Enter password"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-3 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Sign in
                </button>
            </form>

        </div>
    </div>
</div>
