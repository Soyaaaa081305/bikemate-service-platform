FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY BikeMate.Core/BikeMate.Core.csproj BikeMate.Core/
COPY BikeMate.Infrastructure/BikeMate.Infrastructure.csproj BikeMate.Infrastructure/
COPY BikeMate.Api/BikeMate.Api.csproj BikeMate.Api/
RUN dotnet restore BikeMate.Api/BikeMate.Api.csproj

COPY . .
RUN dotnet publish BikeMate.Api/BikeMate.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENTRYPOINT ["dotnet", "BikeMate.Api.dll"]
