@page "/users/create"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject NavigationManager Navigation

<PageTitle>Admin - Create User</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Create User</h1>
            <p class="admin-page-description">Create a customer account directly from the system admin console.</p>
        </div>
        <div class="admin-page-actions">
            <a href="/users" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

    <div class="card admin-form-card">
        <div class="card-body p-4">
            <form @onsubmit="CreateUser" @onsubmit:preventDefault>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">First name</label>
                        <input class="form-control" @bind="model.FirstName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Last name</label>
                        <input class="form-control" @bind="model.LastName" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email address</label>
                        <input class="form-control" type="email" @bind="model.Email" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone number</label>
                        <input class="form-control" @bind="model.PhoneNumber" placeholder="+63..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Password</label>
                        <input class="form-control" type="password" @bind="model.Password" minlength="8" required />
                        <div class="form-text">Use at least 8 characters.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Confirm password</label>
                        <input class="form-control" type="password" @bind="model.ConfirmPassword" minlength="8" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Account status</label>
                        <select class="form-select" @bind="model.AccountStatus">
                            <option value="pending">Pending</option>
                            <option value="active">Active</option>
                            <option value="suspended">Suspended</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="emailVerified" @bind="model.EmailVerified" />
                            <label class="form-check-label" for="emailVerified">Mark email as verified</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel" disabled="@isSaving">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        }
                        Create user
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    private readonly UserCreateDto model = new();
    private string? statusMessage;
    private string statusType = "danger";
    private bool isSaving;

    private async Task CreateUser()
    {
        try
        {
            isSaving = true;
            statusMessage = null;
            var created = await AdminApi.CreateUserAsync(model);
            Navigation.NavigateTo($"/users/edit/{created.UserId}");
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/users");
    }
}
