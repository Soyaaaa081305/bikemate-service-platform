@page "/shops"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi
@inject IJSRuntime JS

<PageTitle>Admin - Shop Directory</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Shop Directory</h1>
            <p class="admin-page-description">View approved and pending partner shops connected to the customer booking flow.</p>
        </div>

        <div class="admin-page-actions">
            <a href="/shops/register" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Register shop
            </a>
            <div class="input-group admin-search shadow-sm">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Search shops" @bind="searchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@statusType" OnMessageCleared="() => statusMessage = null" />

    <div class="card admin-table-card">
        <div class="card-body p-0">
            @if (shops == null)
            {
                <div class="empty-state">
                    <div class="spinner-border text-info" role="status"></div>
                    <p class="mt-2 mb-0">Loading shop directory...</p>
                </div>
            }
            else if (shops.Length == 0)
            {
                <div class="empty-state">No shops registered in the system yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-4">Shop ID</th>
                                <th>Shop name</th>
                                <th>City</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var shop in FilteredShops)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@shop.Id</td>
                                    <td class="fw-semibold">@shop.ShopName</td>
                                    <td>@shop.City</td>
                                    <td>
                                        <span class="@ShopStatusBadgeClass(shop.Status)">@LabelStatus(shop.Status)</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Shop actions">
                                            <a href="/shops/details/@shop.Id" class="btn btn-outline-primary shadow-sm">View details</a>
                                            <a href="/shops/edit/@shop.Id" class="btn btn-outline-secondary shadow-sm">Edit</a>
                                            <button type="button" class="btn btn-outline-danger shadow-sm" @onclick="() => DeleteShop(shop)">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ShopDto[]? shops; 
    private string searchTerm = "";
    private string? statusMessage;
    private string statusType = "danger";

    private IEnumerable<ShopDto> FilteredShops => string.IsNullOrWhiteSpace(searchTerm)
        ? shops ?? Array.Empty<ShopDto>()
        : shops!.Where(s => s.ShopName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                            s.City.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadShops();
    }

    private async Task LoadShops()
    {
        try
        {
            var fetchedShops = await AdminApi.GetShopsAsync();
            shops = (fetchedShops ?? Array.Empty<ShopDto>())
                .OrderByDescending(s => s.Status.ToLower() == "verified")
                .ToArray();

            statusMessage = AdminApi.LastError;
            statusType = string.IsNullOrWhiteSpace(statusMessage) ? statusType : "danger";
        }
        catch (Exception ex)
        {
            shops = Array.Empty<ShopDto>();
            statusType = "danger";
            statusMessage = $"Failed to load shops: {ex.Message}";
        }
    }

    private async Task DeleteShop(ShopDto shop)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete {shop.ShopName}? This removes it from customer discovery, disables services/products, and closes its shop-admin account if it has no other shop.");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await AdminApi.DeleteShopAsync(shop.Id);
            statusType = "success";
            statusMessage = $"{shop.ShopName} was deleted from active shop records.";
            await LoadShops();
        }
        catch (Exception ex)
        {
            statusType = "danger";
            statusMessage = ex.Message;
        }
    }

    private static string LabelStatus(string status)
    {
        return string.IsNullOrWhiteSpace(status)
            ? "Unknown"
            : char.ToUpperInvariant(status[0]) + status[1..].ToLowerInvariant();
    }

    private static string ShopStatusBadgeClass(string status)
    {
        return status.Trim().ToLowerInvariant() switch
        {
            "verified" => "badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill",
            "pending" => "badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill text-dark",
            "suspended" => "badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill",
            "rejected" => "badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill",
            _ => "badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 rounded-pill"
        };
    }
}
