<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.HelpSupport"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Help &amp; Support" Style="{StaticResource HeaderTitle}" />
                    <Label Text="FAQs, documentation, and support tickets." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="&lt;" Style="{StaticResource BackButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Label Text="COMMON QUESTIONS" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="How do shop accounts get approved?" Style="{StaticResource BodyText}" />
                        <Label Text="How do I manage services and products?" Style="{StaticResource BodyText}" />
                        <Label Text="How do I update PayMongo payment status?" Style="{StaticResource BodyText}" />
                    </VerticalStackLayout>
                </Frame>
                <Label Text="CONTACT SUPPORT" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Entry Placeholder="Subject" Style="{StaticResource InputEntry}" />
                        <Editor Placeholder="Describe your issue" Style="{StaticResource InputEditor}" />
                        <Button Text="Send Support Ticket" Style="{StaticResource PrimaryButton}" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
