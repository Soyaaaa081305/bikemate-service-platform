<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.SignOut"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid Padding="24" RowDefinitions="*,Auto,*" BackgroundColor="{StaticResource PageBg}"><Frame Grid.Row="1" Style="{StaticResource CardFrame}"><VerticalStackLayout Spacing="14" HorizontalOptions="Center"><Frame WidthRequest="76" HeightRequest="76" CornerRadius="26" Padding="0" BackgroundColor="{StaticResource SoftRed}" HasShadow="False"><Label Text="↪" FontSize="34" TextColor="{StaticResource Red}" HorizontalOptions="Center" VerticalOptions="Center"/></Frame><Label Text="Sign out?" Style="{StaticResource PageTitle}" HorizontalTextAlignment="Center"/><Label Text="You are signed in as Mark Santos for LJBikeshop." Style="{StaticResource SmallMuted}" HorizontalTextAlignment="Center"/><Button Text="Yes, Sign Out" Style="{StaticResource DangerButton}" Clicked="ConfirmSignOut_Clicked"/><Button Text="Cancel" Style="{StaticResource OutlineButton}" Clicked="Cancel_Clicked"/></VerticalStackLayout></Frame></Grid>

</ContentPage>
