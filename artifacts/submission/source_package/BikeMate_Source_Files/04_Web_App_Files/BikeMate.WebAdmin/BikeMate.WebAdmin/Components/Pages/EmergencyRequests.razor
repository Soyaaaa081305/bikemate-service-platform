@page "/emergency"
@rendermode InteractiveServer
@using BikeMate.WebAdmin.DTOs
@using BikeMate.WebAdmin.Services
@inject AdminApiClient AdminApi

<PageTitle>Emergency Requests</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Emergency Window</h1>
            <p class="admin-page-description">Monitor urgent breakdown, accident, stranded, and no-start service requests.</p>
        </div>

        <div class="admin-page-actions">
            <button class="btn btn-outline-danger shadow-sm" @onclick="LoadEmergencyRequests" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="danger" OnMessageCleared="() => statusMessage = null" />

    <div class="card admin-table-card emergency-card">
        <div class="card-header bg-white border-0 pt-4 pb-3 d-flex justify-content-between align-items-center">
            <div>
                <h2 class="admin-page-title text-danger mb-0"><i class="bi bi-exclamation-octagon-fill me-2"></i>Emergency Queue</h2>
                <small class="text-muted">@EmergencyCount active emergency request@(EmergencyCount == 1 ? "" : "s")</small>
            </div>
            <span class="badge bg-danger px-3 py-2">@EmergencyCount Open</span>
        </div>

        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="empty-state">
                    <div class="spinner-border text-danger" role="status"></div>
                    <p class="mt-2 mb-0">Loading emergency requests...</p>
                </div>
            }
            else if (emergencyRequests.Length == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-shield-check text-success"></i>
                    <h2 class="admin-page-title mt-3">No active emergencies</h2>
                    <p class="text-muted mb-0">Emergency-matching service requests will appear here automatically.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted text-uppercase">
                            <tr>
                                <th class="ps-4">Request ID</th>
                                <th>Customer</th>
                                <th>Emergency type</th>
                                <th>Status</th>
                                <th>Amount</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in emergencyRequests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-danger">#@req.Id</td>
                                    <td class="fw-semibold">@req.ClientName</td>
                                    <td>
                                        <span class="fw-semibold">@req.ServiceName</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                            @req.Status.Replace("_", " ")
                                        </span>
                                    </td>
                                    <td class="text-success fw-bold">PHP @req.TotalAmount.ToString("N2")</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a href="/emergency/call/@req.Id" class="btn btn-sm btn-danger shadow-sm">
                                                Support call
                                            </a>
                                            <a href="/requests/details/@req.Id" class="btn btn-sm btn-outline-danger shadow-sm">
                                                Open request
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ServiceRequestDto[] emergencyRequests = Array.Empty<ServiceRequestDto>();
    private bool isLoading = true;
    private string? statusMessage;
    private int EmergencyCount => emergencyRequests.Length;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmergencyRequests();
    }

    private async Task LoadEmergencyRequests()
    {
        isLoading = true;
        statusMessage = null;

        try
        {
            emergencyRequests = await AdminApi.GetEmergencyRequestsAsync() ?? Array.Empty<ServiceRequestDto>();
            statusMessage = AdminApi.LastError;
        }
        catch (Exception ex)
        {
            emergencyRequests = Array.Empty<ServiceRequestDto>();
            statusMessage = $"Failed to load emergency requests: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
