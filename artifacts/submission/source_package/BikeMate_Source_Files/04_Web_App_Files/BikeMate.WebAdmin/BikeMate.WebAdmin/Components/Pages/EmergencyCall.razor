@page "/emergency/call/{RequestId:int}"
@rendermode InteractiveServer
@using BikeMate.Core.DTOs
@using BikeMate.WebAdmin.Services
@inject IJSRuntime Js
@inject IWebAdminAgoraCallService AgoraCall
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>Emergency Call #@RequestId</PageTitle>

<div class="admin-page">
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Emergency Call #@RequestId</h1>
            <p class="admin-page-description">Join the Agora emergency room with browser camera and microphone.</p>
        </div>
        <div class="admin-page-actions">
            <a class="btn btn-outline-secondary" href="/emergency">Back to emergency queue</a>
        </div>
    </div>

    <ActionMessage Message="@statusMessage" AlertType="@alertType" OnMessageCleared="() => statusMessage = null" />

    <div class="emergency-call-shell">
        <section class="emergency-call-stage">
            <div class="emergency-call-remote" id="remote-player">
                <div class="emergency-call-empty">
                    <i class="bi bi-camera-video"></i>
                    <span id="remote-status">No remote video yet</span>
                    <small id="remote-audio-status">No remote audio yet</small>
                </div>
            </div>
            <div class="emergency-call-local" id="local-player">
                <span>Your camera</span>
            </div>
        </section>

        <aside class="emergency-call-panel">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="admin-page-title mb-2">Call controls</h2>
                    <p class="text-muted mb-3" id="call-status">@callStatus</p>

                    <div class="d-grid gap-2">
                        <button class="btn btn-danger" @onclick="JoinAsync" disabled="@isJoining">
                            @(isConnected ? "Reconnect call" : isJoining ? "Joining..." : "Join emergency call")
                        </button>
                        <button class="btn btn-outline-dark" @onclick="ToggleMuteAsync" disabled="@(!isConnected)">
                            @(isMuted ? "Unmute microphone" : "Mute microphone")
                        </button>
                        <button class="btn btn-outline-dark" @onclick="ToggleCameraAsync" disabled="@(!isConnected)">
                            @(isCameraOn ? "Turn camera off" : "Turn camera on")
                        </button>
                        <button class="btn btn-outline-danger" @onclick="LeaveAsync" disabled="@(!isConnected)">
                            End call on this browser
                        </button>
                    </div>

                    @if (session is not null)
                    {
                        <div class="emergency-call-meta mt-4">
                            <div><strong>Channel</strong><span>@session.ChannelName</span></div>
                            <div><strong>Admin UID</strong><span>@session.Uid</span></div>
                            <div><strong>Token expires</strong><span>@(session.ExpiresAt?.ToLocalTime().ToString("MMM d, h:mm tt") ?? "Unknown")</span></div>
                        </div>
                    }
                </div>
            </div>

            <div class="alert alert-warning mt-3 mb-0">
                Camera and microphone permissions require HTTPS or localhost. Use the browser permission icon if access is blocked.
            </div>
        </aside>
    </div>
</div>

@code {
    [Parameter]
    public int RequestId { get; set; }

    private EmergencyCallSessionDto? session;
    private string? statusMessage;
    private string alertType = "info";
    private string callStatus = "Ready to join.";
    private bool isJoining;
    private bool isConnected;
    private bool isMuted;
    private bool isCameraOn = true;

    private async Task JoinAsync()
    {
        isJoining = true;
        statusMessage = null;
        callStatus = "Preparing Agora session...";

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            session = AgoraCall.CreateEmergencyCallSession(
                RequestId,
                authState.User.Identity?.Name,
                DateTime.UtcNow);
            if (!string.Equals(session?.CallStatus, "TokenReady", StringComparison.OrdinalIgnoreCase))
            {
                statusMessage = session?.Message ?? "Agora token is not ready.";
                alertType = "danger";
                return;
            }

            await Js.InvokeVoidAsync("bikeMateEmergencyCall.join", session);
            isConnected = true;
            isMuted = false;
            isCameraOn = true;
            callStatus = "Connected.";
            statusMessage = "Emergency call connected in this browser.";
            alertType = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Could not join Agora call: {ex.Message}";
            alertType = "danger";
            callStatus = "Join failed.";
        }
        finally
        {
            isJoining = false;
        }
    }

    private async Task ToggleMuteAsync()
    {
        isMuted = !isMuted;
        await Js.InvokeVoidAsync("bikeMateEmergencyCall.setMuted", isMuted);
    }

    private async Task ToggleCameraAsync()
    {
        isCameraOn = !isCameraOn;
        await Js.InvokeVoidAsync("bikeMateEmergencyCall.setCamera", isCameraOn);
    }

    private async Task LeaveAsync()
    {
        await Js.InvokeVoidAsync("bikeMateEmergencyCall.leave");
        isConnected = false;
        callStatus = "Call ended on this browser.";
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("bikeMateEmergencyCall.leave");
        }
        catch
        {
            // Ignore JS disposal errors during navigation or circuit shutdown.
        }
    }
}
