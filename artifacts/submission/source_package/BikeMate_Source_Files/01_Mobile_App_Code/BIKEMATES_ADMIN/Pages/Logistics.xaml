<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Logistics"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Logistics" Style="{StaticResource HeaderTitle}" />
                    <Label Text="Sales, orders, payments, and revenue." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="&lt;" Style="{StaticResource BackButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Frame Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="PHP 0.00" Style="{StaticResource StatNumber}" /><Label Text="Sales" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="0" Style="{StaticResource StatNumber}" /><Label Text="Paid Orders" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                    <Frame Grid.Row="1" Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="0" Style="{StaticResource StatNumber}" /><Label Text="Pending Payments" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="0" Style="{StaticResource StatNumber}" /><Label Text="Completed Jobs" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                </Grid>

                <Label Text="PayMongo Payments" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <Label Text="No payment/order rows returned by the API yet." Style="{StaticResource SmallMuted}" />
                </Frame>

                <Label Text="Inventory Movement" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <Label Text="Inventory movement will appear after product/order endpoints return real history." Style="{StaticResource SmallMuted}" />
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
