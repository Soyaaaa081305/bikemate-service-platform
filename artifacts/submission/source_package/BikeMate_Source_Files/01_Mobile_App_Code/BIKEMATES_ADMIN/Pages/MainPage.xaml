<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <RefreshView x:Name="DashboardRefreshView" Refreshing="DashboardRefreshView_Refreshing">
        <ScrollView>
            <VerticalStackLayout Spacing="0" BackgroundColor="{StaticResource PageBg}">
                <Grid BackgroundColor="{StaticResource Orange}" Padding="18,22,18,62">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="48"
                               HeightRequest="48"
                               CornerRadius="16"
                               Padding="0"
                               BackgroundColor="White"
                               HasShadow="False">
                            <Image Source="bikemate_logo.png"
                                   Aspect="AspectFit"
                                   Margin="5" />
                        </Frame>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="WelcomeLabel"
                                       Text="Welcome, Admin"
                                       Style="{StaticResource HeaderTitle}"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="RolePillLabel"
                                       Text="ADMIN"
                                       Style="{StaticResource Pill}"
                                       BackgroundColor="{StaticResource Navy}" />
                            </HorizontalStackLayout>
                            <Label x:Name="ShopNameLabel"
                                   Text="Loading assigned bike shop..."
                                   Style="{StaticResource HeaderSubtitle}"
                                   TextColor="#FFF2EA"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Button Grid.Column="2"
                                x:Name="NotificationsButton"
                                Text="Alerts"
                                Style="{StaticResource MiniButton}"
                                BackgroundColor="White"
                                Clicked="Notifications_Clicked" />
                        <Button Grid.Column="3"
                                Text="Out"
                                Style="{StaticResource MiniButton}"
                                BackgroundColor="White"
                                Clicked="SignOut_Clicked" />
                    </Grid>

                    <VerticalStackLayout Grid.Row="1"
                                         Margin="0,18,0,0"
                                         Spacing="4">
                        <Label Text="Shop Operations"
                               Style="{StaticResource HeaderTitle}" />
                        <Label Text="Monitor bookings, mechanics, services, inventory, and customer updates."
                               Style="{StaticResource HeaderSubtitle}"
                               TextColor="#FFF2EA"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <Frame Style="{StaticResource CardFrame}"
                       Margin="14,-42,14,0"
                       Padding="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="MONTHLY REVENUE"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0" />
                            <Label x:Name="RevenueLabel"
                                   Text="PHP 0.00"
                                   Style="{StaticResource PageTitle}" />
                            <Label Text="Synced from paid bookings and completed shop activity."
                                   Style="{StaticResource SmallMuted}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Frame Grid.Column="1"
                               Padding="10,6"
                               CornerRadius="12"
                               BackgroundColor="{StaticResource SoftGreen}"
                               BorderColor="{StaticResource SoftGreen}"
                               HasShadow="False"
                               VerticalOptions="Start">
                            <Label x:Name="ApiStatusLabel"
                                   Text="API"
                                   FontSize="11"
                                   FontFamily="PTSansCaptionBold"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" />
                        </Frame>
                    </Grid>
                </Frame>

                <VerticalStackLayout Padding="14,14,14,30" Spacing="14">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Frame Style="{StaticResource SmallCardFrame}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label x:Name="ServicesLabel"
                                       Text="0"
                                       Style="{StaticResource StatNumber}" />
                                <Label Grid.Row="1"
                                       Text="Active services"
                                       Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </Frame>

                        <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label x:Name="ActiveBookingsLabel"
                                       Text="0"
                                       Style="{StaticResource StatNumber}" />
                                <Label Grid.Row="1"
                                       Text="Active bookings"
                                       Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </Frame>

                        <Frame Grid.Row="1" Style="{StaticResource SmallCardFrame}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label x:Name="TodaysBookingsLabel"
                                       Text="0"
                                       Style="{StaticResource StatNumber}" />
                                <Label Grid.Row="1"
                                       Text="Bookings today"
                                       Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </Frame>

                        <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <Label x:Name="LowStockLabel"
                                       Text="0"
                                       Style="{StaticResource StatNumber}" />
                                <Label Grid.Row="1"
                                       Text="Low stock"
                                       Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </Frame>
                    </Grid>

                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Run the Shop" Style="{StaticResource ItemTitle}" />
                                    <Label Text="Fast access to the work you do most."
                                           Style="{StaticResource SmallMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Messages"
                                        Style="{StaticResource MiniButton}"
                                        Clicked="Messages_Clicked" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Button Text="Products"
                                        Style="{StaticResource DarkButton}"
                                        Clicked="Products_Clicked" />
                                <Button Grid.Column="1"
                                        Text="Services"
                                        Style="{StaticResource PrimaryButton}"
                                        Clicked="Operations_Clicked" />
                                <Button Grid.Row="1"
                                        Text="Bookings"
                                        Style="{StaticResource OutlineButton}"
                                        Clicked="Calendar_Clicked" />
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Reports"
                                        Style="{StaticResource OutlineButton}"
                                        Clicked="Reports_Clicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="MECHANICS" Style="{StaticResource SectionLabel}" />
                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Mechanic Status" Style="{StaticResource ItemTitle}" />
                                    <Label Text="Availability from assigned mechanic accounts."
                                           Style="{StaticResource SmallMuted}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Manage"
                                        Style="{StaticResource MiniButton}"
                                        Clicked="Admins_Clicked" />
                            </Grid>

                            <CollectionView x:Name="MechanicsCollectionView"
                                            ItemsSource="{Binding Mechanics}"
                                            HeightRequest="104"
                                            ItemsLayout="HorizontalList">
                                <CollectionView.EmptyView>
                                    <Grid Padding="0,10">
                                        <Label Text="No mechanics returned by the API yet."
                                               Style="{StaticResource SmallMuted}"
                                               HorizontalTextAlignment="Center" />
                                    </Grid>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame WidthRequest="96"
                                               Margin="0,0,8,0"
                                               Padding="10"
                                               CornerRadius="12"
                                               BackgroundColor="{StaticResource SoftGray}"
                                               BorderColor="{StaticResource LineColor}"
                                               HasShadow="False">
                                            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                                <Frame WidthRequest="42"
                                                       HeightRequest="42"
                                                       CornerRadius="14"
                                                       Padding="0"
                                                       BackgroundColor="{Binding StatusColor}"
                                                       HasShadow="False">
                                                    <Label Text="{Binding Initials}"
                                                           TextColor="White"
                                                           FontAttributes="Bold"
                                                           FontFamily="Inter"
                                                           FontSize="13"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Frame>
                                                <Label Text="{Binding Name}"
                                                       Style="{StaticResource TinyMuted}"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontFamily="PTSansCaptionBold"
                                                       TextColor="{Binding StatusColor}"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Label Text="ACTIVITY" Style="{StaticResource SectionLabel}" />
                    <Frame Style="{StaticResource CardFrame}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Frame WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="12"
                                   Padding="0"
                                   BackgroundColor="{StaticResource SoftOrange}"
                                   BorderColor="{StaticResource SoftOrange}"
                                   HasShadow="False">
                                <Label Text="!"
                                       TextColor="{StaticResource OrangeDark}"
                                       FontAttributes="Bold"
                                       FontFamily="Inter"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Latest Shop Update" Style="{StaticResource ItemTitle}" />
                                <Label x:Name="ActivityLabel"
                                       Text="Recent activity will appear when the API returns bookings, service changes, messages, and inventory events."
                                       Style="{StaticResource SmallMuted}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
