<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.AccCreate3"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="#242424" StrokeThickness="0" Padding="20,24,20,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="Create an Account" FontSize="18" FontAttributes="Bold" TextColor="White" />
                <Label Text="Step 4 of 5 - Shop details" FontSize="13" TextColor="#E6E6E6" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,22" Spacing="14">
                <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Shop information" FontSize="18" FontAttributes="Bold" TextColor="#242424" />
                        <Label Text="Enter the official shop details for BikeMate admin review." FontSize="13" TextColor="#6E6E6E" />

                        <Border BackgroundColor="#FFF3EA" Stroke="#FFB37A" Padding="12">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Label Text="You can submit the application now, but the account cannot use shop features until the web admin approves it."
                                   FontSize="13"
                                   TextColor="#7A3A12" />
                        </Border>

                        <Label Text="Official bike shop name *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="ShopNameEntry" Placeholder="Bike shop name" />
                        </Border>

                        <Label Text="Shop description" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Editor x:Name="ShopDescriptionEditor"
                                    Placeholder="Briefly describe your shop, specialties, services, brands handled, and what customers should know."
                                    AutoSize="TextChanges"
                                    HeightRequest="96" />
                        </Border>
                        <Label Text="This appears in the admin review and customer-facing shop profile after approval."
                               FontSize="11"
                               TextColor="#6E6E6E" />

                        <Label x:Name="LocationStatusLabel" Text="" FontSize="11" TextColor="#6E6E6E" />

                        <Label Text="Region *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Picker x:Name="RegionPicker"
                                    Title="Select region"
                                    SelectedIndexChanged="OnRegionChanged" />
                        </Border>

                        <Label Text="City / Municipality *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Picker x:Name="CityPicker"
                                    Title="Select city or municipality"
                                    SelectedIndexChanged="OnCityChanged" />
                        </Border>

                        <Label x:Name="ProvinceLabel" Text="" FontSize="11" TextColor="#6E6E6E" />

                        <Label Text="Barangay *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Picker x:Name="BarangayPicker"
                                    Title="Select barangay" />
                        </Border>

                        <Label Text="Complete address *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="AddressEntry" Placeholder="Street, building, or landmark" />
                        </Border>

                        <Label Text="Zip code *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="ZipCodeEntry" Placeholder="Zip code" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="ContinueButton"
                Grid.Row="2"
                Text="Continue"
                BackgroundColor="#FF6B00"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Margin="20,10,20,24"
                Clicked="OnContinueClicked" />
    </Grid>
</ContentPage>
