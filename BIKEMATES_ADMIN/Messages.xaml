<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Messages"
             BackgroundColor="{StaticResource PageBg}"
             Title="Messages"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Messages" Style="{StaticResource HeaderTitle}" />
                <Label Text="Customer and admin conversations" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button x:Name="CustomersTabButton" Text="Customers" Style="{StaticResource MessengerTab}" Clicked="OnCustomersTabClicked" />
                    <Button x:Name="AdminsTabButton" Grid.Column="1" Text="Admins" Style="{StaticResource MessengerTab}" Clicked="OnAdminsTabClicked" />
                    <Button x:Name="MechanicsTabButton" Grid.Column="2" Text="Mechanics" Style="{StaticResource MessengerTab}" Clicked="OnMechanicsTabClicked" />
                </Grid>

                <Entry x:Name="MessageSearchEntry" Placeholder="Search Messenger" Style="{StaticResource InputEntry}" />

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="SectionTitleLabel" Text="Customer Messages" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="ConversationListLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Chat Preview" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="OtherBubbleOneLabel" Text="Hello po, update sa brake repair?" Style="{StaticResource ChatBubbleOther}" HorizontalOptions="Start" />
                        <Label x:Name="MyBubbleLabel" Text="Hi sir, assigned na po si Jose." Style="{StaticResource ChatBubbleMe}" HorizontalOptions="End" />
                        <Label x:Name="OtherBubbleTwoLabel" Text="Thank you!" Style="{StaticResource ChatBubbleOther}" HorizontalOptions="Start" />
                        <Editor x:Name="MessageEntry" Placeholder="Type message" AutoSize="TextChanges" HeightRequest="90" Style="{StaticResource InputEditor}" />
                        <Button Text="Send Message" Style="{StaticResource PrimaryButton}" Clicked="OnSendClicked" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="2" Text="Notifications" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnNotificationsClicked" />
            <Button Grid.Column="3" Text="Profile" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnProfileClicked" />
        </Grid>
    </Grid>
</ContentPage>
