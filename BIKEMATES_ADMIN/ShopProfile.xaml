<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.ShopProfile"
             BackgroundColor="{StaticResource PageBg}"
             Title="Shop Profile"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Shop Profile" Style="{StaticResource HeaderTitle}" />
                <Label Text="Customize your public shop page" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Edit" WidthRequest="48" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnSaveClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame CornerRadius="20" Padding="0" HeightRequest="160" HasShadow="False" BorderColor="Transparent" BackgroundColor="{StaticResource Navy}">
                    <Grid BackgroundColor="{StaticResource Navy}">
                        <Label Text="Shop Cover Photo" TextColor="#B8C0CC" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Frame WidthRequest="78" HeightRequest="78" CornerRadius="22" Padding="0" HasShadow="False" BackgroundColor="White" BorderColor="White" HorizontalOptions="Start" VerticalOptions="End" Margin="16,0,0,-24">
                            <Image Source="bikemate_logo.png" HeightRequest="48" WidthRequest="48" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                    </Grid>
                </Frame>

                <BoxView HeightRequest="20" Color="Transparent" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="LJBikeshop" FontSize="22" FontAttributes="Bold" />
                        <Label Text="Trusted bike parts, repairs, and roadside support." Style="{StaticResource SmallMuted}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Save Profile" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
                            <Button Grid.Column="1" Text="Preview Page" Style="{StaticResource OutlineButton}" Clicked="OnPreviewClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Public Information" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Shop Name" Style="{StaticResource SmallMuted}" />
                        <Entry x:Name="ShopNameEntry" Placeholder="Shop name" Style="{StaticResource InputEntry}" />
                        <Label Text="Shop Description" Style="{StaticResource SmallMuted}" />
                        <Editor x:Name="DescriptionEditor" Placeholder="Shop description" HeightRequest="90" Style="{StaticResource InputEditor}" />
                        <Label Text="Address" Style="{StaticResource SmallMuted}" />
                        <Entry x:Name="AddressEntry" Placeholder="Shop address" Style="{StaticResource InputEntry}" />
                        <Label x:Name="StatusLabel" Text="Profile completeness: 82%" Style="{StaticResource SmallMuted}" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Registration Documents" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftBlue}" BorderColor="Transparent">
                            <Label Text="DOC" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Blue}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Business Permit" Style="{StaticResource ItemTitle}" />
                            <Label Text="Uploaded - permit_2026.pdf" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="View" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftGreen}" BorderColor="Transparent">
                            <Label Text="DTI" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="DTI Registration Number" Style="{StaticResource ItemTitle}" />
                            <Label Text="DTI-2026-009182" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Edit" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMessagesClicked" />
            <Button Grid.Column="2" Text="Profile" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
