<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Intro.AppIntro2"
             BackgroundColor="White">

    <Grid Padding="20,34,20,28" RowDefinitions="*,Auto">
        <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="22" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Image Source="bike_wrench.png" HeightRequest="122" HorizontalOptions="Center" />
                <Label Text="Run your bike shop from anywhere"
                       FontFamily="Inter"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#242424"
                       HorizontalTextAlignment="Center" />
                <Label Text="Manage bookings, services, mechanics, and inventory from one admin app."
                       FontSize="13"
                       TextColor="#6E6E6E"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="1"
                Text="Continue"
                BackgroundColor="#FF6B00"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnContinueClicked" />
    </Grid>
</ContentPage>
