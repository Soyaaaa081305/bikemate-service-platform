<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.AccCreate5"
             BackgroundColor="White">

    <Grid RowDefinitions="*,Auto" Padding="20,26">
        <Border Grid.Row="0" BackgroundColor="White" Stroke="#E6E6E6" Padding="20" VerticalOptions="Center">
            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Image Source="account_success.png" HeightRequest="154" WidthRequest="154" HorizontalOptions="Center" />
                <Label x:Name="TitleLabel"
                       Text="Verify your email"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#242424"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="SuccessDetailsLabel"
                       Text="Enter the OTP sent to your email. Your shop application will still need BikeMate admin approval after email verification."
                       FontSize="13"
                       TextColor="#6E6E6E"
                       HorizontalTextAlignment="Center" />
                <Border x:Name="OtpInputFrame" Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Entry x:Name="OtpEntry"
                           Placeholder="6-digit OTP"
                           Keyboard="Numeric"
                           MaxLength="6"
                           HorizontalTextAlignment="Center"
                           TextColor="#242424"
                           PlaceholderColor="#6E6E6E" />
                </Border>
                <Button x:Name="VerifyButton"
                        Text="Verify Email"
                        BackgroundColor="#FF6B2C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnVerifyClicked" />
                <Button x:Name="ResendButton"
                        Text="Resend OTP"
                        BackgroundColor="Transparent"
                        TextColor="#FF6B2C"
                        BorderColor="#FF6B2C"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnResendClicked" />
                <Button x:Name="ApplicationDetailsButton"
                        Text="View Submitted Application"
                        BackgroundColor="Transparent"
                        TextColor="#242424"
                        BorderColor="#DCDCDC"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnViewApplicationClicked" />
                <Button Text="Return to Login"
                        BackgroundColor="Transparent"
                        TextColor="#6E6E6E"
                        BorderColor="#DCDCDC"
                        BorderWidth="1"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnReturnToLoginClicked" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="ProceedButton"
                Grid.Row="1"
                Text="Verify OTP to continue"
                BackgroundColor="#DCDCDC"
                TextColor="#6E6E6E"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                IsEnabled="False"
                Clicked="OnProceedToLoginClicked" />
    </Grid>
</ContentPage>
