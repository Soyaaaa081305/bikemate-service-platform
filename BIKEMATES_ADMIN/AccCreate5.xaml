<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.AccCreate5"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="*,Auto" Padding="20,26">
        <Border Grid.Row="0" BackgroundColor="White" Stroke="#E6E6E6" Padding="20" VerticalOptions="Center">
            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Image Source="account_success.png" HeightRequest="154" WidthRequest="154" HorizontalOptions="Center" />
                <Label Text="Account Successfully Created"
                       FontSize="21"
                       FontAttributes="Bold"
                       TextColor="#242424"
                       HorizontalTextAlignment="Center" />
                <Label Text="Welcome to BIKEMATES"
                       FontSize="14"
                       TextColor="#6E6E6E"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="1"
                Text="Proceed to Login"
                BackgroundColor="#18D64B"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnProceedToLoginClicked" />
    </Grid>
</ContentPage>
