<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Popups.SendToEmailPage"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="*,Auto" Padding="20,26">
        <Border Grid.Row="0" BackgroundColor="White" Stroke="#E6E6E6" Padding="20" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="16">
                <Label Text="Enter Admin Email Address"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#242424"
                       HorizontalTextAlignment="Center" />
                <Label Text="BikeMate will open your email app with the account creation code ready to send."
                       FontSize="13"
                       TextColor="#6E6E6E"
                       HorizontalTextAlignment="Center" />
                <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Entry x:Name="EmailEntry" Placeholder="ex.admin@email.com" Keyboard="Email" />
                </Border>
                <Button Text="SEND TO EMAIL"
                        BackgroundColor="#FF6B2C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnSendClicked" />
            </VerticalStackLayout>
        </Border>

        <Button Grid.Row="1"
                Text="Return"
                BackgroundColor="Transparent"
                TextColor="#FF6B2C"
                FontAttributes="Bold"
                Clicked="OnReturnClicked" />
    </Grid>
</ContentPage>
