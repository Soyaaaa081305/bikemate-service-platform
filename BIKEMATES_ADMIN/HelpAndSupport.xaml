<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.HelpAndSupport"
             BackgroundColor="{StaticResource PageBg}"
             Title="Help and Support"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Help and Support" Style="{StaticResource HeaderTitle}" />
                <Label Text="Get admin assistance" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Quick Help" FontSize="18" FontAttributes="Bold" />
                        <Entry x:Name="SearchEntry" Placeholder="Search help topic" Style="{StaticResource InputEntry}" />
                        <Button Text="Search" Style="{StaticResource DarkButton}" Clicked="OnSearchClicked" />
                        <Label x:Name="HelpResultLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Support Ticket" FontSize="18" FontAttributes="Bold" />
                        <Editor x:Name="TicketEditor" Placeholder="Describe the issue" AutoSize="TextChanges" HeightRequest="100" Style="{StaticResource InputEditor}" />
                        <Button Text="Submit Ticket" Style="{StaticResource PrimaryButton}" Clicked="OnSubmitTicketClicked" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Settings" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnSettingsClicked" />
            <Button Grid.Column="2" Text="Help" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
