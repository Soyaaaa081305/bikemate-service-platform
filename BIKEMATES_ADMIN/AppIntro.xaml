<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Intro.AppIntro"
             BackgroundColor="#F6F6F6">

    <Grid Padding="20,34,20,28" RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0" Spacing="14" VerticalOptions="Center">
            <Image Source="bikemate_logo.png" HeightRequest="116" HorizontalOptions="Center" />
            <Label Text="BIKEMATES ADMIN"
                   FontFamily="OpenSansSemibold"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#242424"
                   HorizontalTextAlignment="Center" />
            <Label Text="A shop command center for orders, mechanics, products, and customer requests."
                   FontSize="14"
                   TextColor="#6E6E6E"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="Let's Go"
                BackgroundColor="#FF6B2C"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Clicked="OnLetGoClicked" />
    </Grid>
</ContentPage>
