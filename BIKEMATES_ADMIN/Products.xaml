<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Products"
             BackgroundColor="{StaticResource PageBg}"
             Title="Products"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Products" Style="{StaticResource HeaderTitle}" />
                <Label Text="Bikes, parts, accessories, and inventory" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="+" WidthRequest="38" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" FontSize="18" Clicked="OnAddProductClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Entry Placeholder="Search products, parts, categories..." Style="{StaticResource InputEntry}" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="{StaticResource Navy}" BorderColor="{StaticResource Navy}">
                            <Label Text="All" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Frame>
                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource LineColor}">
                            <Label Text="Frames" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                        </Frame>
                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource LineColor}">
                            <Label Text="Drivetrain" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                        </Frame>
                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource LineColor}">
                            <Label Text="Wheels" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                        </Frame>
                        <Frame Padding="12,8" CornerRadius="18" HasShadow="False" BackgroundColor="White" BorderColor="{StaticResource LineColor}">
                            <Label Text="Brakes" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                        </Frame>
                    </HorizontalStackLayout>
                </ScrollView>

                <Label Text="Inventory Summary" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Frame Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout>
                            <Label x:Name="ProductCountLabel" Text="0" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Total Products" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}" BorderColor="#FCA5A5">
                        <VerticalStackLayout>
                            <Label x:Name="LowStockLabel" Text="0" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                            <Label Text="Low Stock" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Label Text="Product GridView" Style="{StaticResource SectionLabel}" />
                <CollectionView x:Name="ProductGridView"
                                SelectionMode="Single"
                                SelectionChanged="OnProductGridSelectionChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource SmallCardFrame}" Margin="0,0,0,8">
                                <VerticalStackLayout Spacing="6">
                                    <Frame WidthRequest="42" HeightRequest="42" CornerRadius="12" Padding="0" HasShadow="False" HorizontalOptions="Start" BackgroundColor="{StaticResource SoftOrange}" BorderColor="Transparent">
                                        <Label Text="PART" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Orange}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                    <Label Text="{Binding Category}" Style="{StaticResource SmallMuted}" />
                                    <Label Text="{Binding PriceText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding StockText}" Style="{StaticResource SmallMuted}" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding StockState}" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Orange}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Selected Product" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Picker x:Name="ProductPicker" Title="Select product" SelectedIndexChanged="OnProductSelected" />
                        <Label x:Name="InventorySummaryLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Edit Selected" Style="{StaticResource DarkButton}" Clicked="OnEditProductClicked" />
                            <Button Grid.Column="1" Text="Delete" BackgroundColor="{StaticResource SoftRed}" TextColor="{StaticResource Red}" BorderColor="#FCA5A5" BorderWidth="1" CornerRadius="14" Clicked="OnDeleteProductClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Add / Edit Product" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Product Name" Style="{StaticResource SmallMuted}" />
                        <Entry x:Name="ProductNameEntry" Placeholder="Enter product name" Style="{StaticResource InputEntry}" />
                        <Label Text="Category" Style="{StaticResource SmallMuted}" />
                        <Picker x:Name="CategoryPicker" Title="Category" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="PriceEntry" Placeholder="Price" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1" x:Name="StockEntry" Placeholder="Stock" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Editor x:Name="ProductNotesEditor" Placeholder="Product notes or specifications" AutoSize="TextChanges" HeightRequest="80" Style="{StaticResource InputEditor}" />
                        <Button Text="Save Product" Style="{StaticResource PrimaryButton}" Clicked="OnAddProductClicked" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Change Log" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Label x:Name="ProductChangeLogLabel"
                           Text="GridView is ready. Add, edit, or delete products to see changes here."
                           Style="{StaticResource SmallMuted}"
                           LineBreakMode="WordWrap" />
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMessagesClicked" />
            <Button Grid.Column="2" Text="Profile" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnProfileClicked" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
