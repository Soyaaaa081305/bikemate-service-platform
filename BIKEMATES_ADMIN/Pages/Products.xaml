<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Products"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt;" Style="{StaticResource BackButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Products" Style="{StaticResource HeaderTitle}" />
                    <Label Text="Manage customer-visible inventory." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Product Editor" Style="{StaticResource SectionLabel}" />
                                <Label x:Name="ProductEditorStatusLabel"
                                       Text="Add a product, or choose one from inventory to edit price, stock, category, and image."
                                       Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Clear" Style="{StaticResource OutlineButton}" Clicked="ClearProductEditor_Clicked" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="104,*" ColumnSpacing="12">
                            <Frame WidthRequest="104" HeightRequest="104" CornerRadius="14" Padding="0" HasShadow="False" BorderColor="{StaticResource LineColor}" BackgroundColor="{StaticResource SoftGray}">
                                <Grid>
                                    <Image x:Name="ProductPreviewImage" Aspect="AspectFill" />
                                    <Label x:Name="ProductPreviewLabel" Text="Image" Style="{StaticResource SmallMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Entry x:Name="ProductNameEntry" Placeholder="Product name" Style="{StaticResource InputEntry}" />
                                <Button Text="Choose Product Image" Style="{StaticResource OutlineButton}" Clicked="PickProductImage_Clicked" />
                            </VerticalStackLayout>
                        </Grid>

                        <Frame Style="{StaticResource SmallCardFrame}" BackgroundColor="{StaticResource SoftGray}" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Category" Style="{StaticResource TinyMuted}" />
                                <SearchBar x:Name="ProductCategorySearchBar"
                                           Placeholder="Search existing categories"
                                           Style="{StaticResource SearchInput}"
                                           TextChanged="ProductCategorySearchBar_TextChanged" />
                                <Picker x:Name="CategoryPicker" Title="Product category" Style="{StaticResource InputPicker}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Entry x:Name="ProductCategoryNameEntry"
                                           Placeholder="New category"
                                           Style="{StaticResource InputEntry}" />
                                    <Button Grid.Column="1" Text="Add" Style="{StaticResource MiniButton}" Clicked="AddProductCategory_Clicked" />
                                    <Button Grid.Column="2" Text="Delete" Style="{StaticResource DangerButton}" Clicked="DeleteProductCategory_Clicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="PriceEntry" Placeholder="Price e.g. 850" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1" x:Name="StockEntry" Placeholder="Stock e.g. 12" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                        </Grid>

                        <Editor x:Name="DescriptionEditor" Placeholder="Product description" Style="{StaticResource InputEditor}" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Add" Style="{StaticResource PrimaryButton}" Clicked="AddProduct_Clicked" />
                            <Button Grid.Column="1" Text="Update" Style="{StaticResource DarkButton}" Clicked="UpdateProduct_Clicked" />
                            <Button Grid.Column="2" Text="Delete" Style="{StaticResource DangerButton}" Clicked="DeleteProduct_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Inventory" Style="{StaticResource SectionLabel}" />
                        <Label Text="Products customers can view from your shop." Style="{StaticResource SmallMuted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="{Binding VisibleProducts.Count, StringFormat='{0} shown'}" Style="{StaticResource Pill}" VerticalOptions="Center" />
                </Grid>

                <SearchBar x:Name="ProductSearchBar" Placeholder="Search products" Style="{StaticResource SearchInput}" TextChanged="ProductSearchBar_TextChanged" />

                <CollectionView x:Name="ProductsCollectionView"
                                ItemsSource="{Binding VisibleProducts}"
                                SelectionMode="Single"
                                SelectionChanged="ProductsCollectionView_SelectionChanged">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="No products in this view" Style="{StaticResource ItemTitle}" HorizontalTextAlignment="Center" />
                                <Label Text="Clear search or add your first customer-visible product with an image, price, and stock count."
                                       Style="{StaticResource SmallMuted}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Button Text="Clear search"
                                        Style="{StaticResource OutlineButton}"
                                        Clicked="ClearProductSearch_Clicked" />
                            </VerticalStackLayout>
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,4" Style="{StaticResource SmallCardFrame}">
                                <Grid ColumnDefinitions="74,*,92" ColumnSpacing="10">
                                    <Frame WidthRequest="74" HeightRequest="74" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftGray}" BorderColor="{StaticResource LineColor}">
                                        <Image Source="{Binding ProductImage}" Aspect="AspectFill" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                        <Label Text="{Binding Category}" Style="{StaticResource TinyMuted}" />
                                        <Label Text="{Binding StockText}" Style="{StaticResource TinyMuted}" />
                                        <Label Text="{Binding StockStatus}" BackgroundColor="{Binding StockStatusColor}" TextColor="White" FontSize="10" FontAttributes="Bold" Padding="8,4" HorizontalOptions="Start" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="7" VerticalOptions="Center">
                                        <Label Text="{Binding PriceText}" TextColor="{StaticResource Orange}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                        <Button Text="Edit"
                                                Style="{StaticResource OutlineButton}"
                                                CommandParameter="{Binding .}"
                                                Clicked="EditProduct_Clicked" />
                                        <Button Text="Delete"
                                                Style="{StaticResource DangerButton}"
                                                CommandParameter="{Binding .}"
                                                Clicked="DeleteProductRow_Clicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
