<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.ShopProfile"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="14,0,14,30">
            <Grid HeightRequest="210">
                <Frame CornerRadius="0" Padding="0" BackgroundColor="{StaticResource Navy}" HasShadow="False">
                    <Grid>
                        <Image x:Name="ShopCoverImage" Aspect="AspectFill" />
                        <Label x:Name="ShopCoverPlaceholder"
                               Text="Shop cover image will appear here"
                               TextColor="#DDE6EF"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <Frame WidthRequest="92" HeightRequest="92" CornerRadius="26" Padding="0" BackgroundColor="{StaticResource Orange}" HasShadow="False" VerticalOptions="End" HorizontalOptions="Start" Margin="18,0,0,-20">
                    <Grid>
                        <Image x:Name="ShopLogoImage" Aspect="AspectFill" />
                        <Label x:Name="ShopLogoPlaceholder" Text="BM" TextColor="White" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </Grid>
            <Frame Style="{StaticResource CardFrame}" Margin="0,20,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ShopTitleLabel" Text="Loading shop profile..." Style="{StaticResource PageTitle}" />
                    <Label x:Name="ShopStatusLabel" Text="Status: loading" Style="{StaticResource SmallMuted}" />
                    <Label x:Name="ShopLocationLabel" Text="Location not loaded yet" Style="{StaticResource BodyText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Request Changes" Style="{StaticResource PrimaryButton}" Clicked="SaveProfile_Clicked" />
                        <Button Grid.Column="1" Text="Reload" Style="{StaticResource OutlineButton}" Clicked="Reload_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
            <Label Text="APPLICATION RECORD" Style="{StaticResource SectionLabel}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Submitted shop details" Style="{StaticResource ItemTitle}" />
                    <Label x:Name="ApplicationSummaryLabel"
                           Text="View the owner details, address, DTI, permit, cover photo / shop image, and valid ID submitted for BikeMate admin review."
                           Style="{StaticResource SmallMuted}" />
                    <VerticalStackLayout x:Name="ApplicationSnapshotStack" Spacing="8" />
                    <Button Text="View Submitted Application"
                            Style="{StaticResource OutlineButton}"
                            Clicked="ApplicationDetails_Clicked" />
                </VerticalStackLayout>
            </Frame>
            <Label Text="SHOP DETAILS" Style="{StaticResource SectionLabel}" />
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Entry x:Name="ShopNameEntry" Placeholder="Shop Name" Style="{StaticResource InputEntry}" IsReadOnly="True" />
                    <Editor x:Name="ShopDescriptionEditor" Placeholder="Shop Description" Style="{StaticResource InputEditor}" IsReadOnly="True" />
                    <Entry x:Name="ShopAddressEntry" Placeholder="Address" Style="{StaticResource InputEntry}" IsReadOnly="True" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Entry x:Name="ShopCityEntry" Placeholder="City" Style="{StaticResource InputEntry}" IsReadOnly="True" />
                        <Entry x:Name="ShopProvinceEntry" Grid.Column="1" Placeholder="Province" Style="{StaticResource InputEntry}" IsReadOnly="True" />
                    </Grid>
                    <Entry x:Name="ContactNumberEntry" Placeholder="Contact number" Style="{StaticResource InputEntry}" IsReadOnly="True" />
                </VerticalStackLayout>
            </Frame>
            <Label Text="OPERATING HOURS" Style="{StaticResource SectionLabel}" />
            <Frame Style="{StaticResource CardFrame}">
                <Label Text="Operating hours can be connected when the API exposes shop_operating_hours endpoints." Style="{StaticResource SmallMuted}" />
            </Frame>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
