<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Notifications"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="&lt;" Style="{StaticResource BackButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Notifications" Style="{StaticResource HeaderTitle}" />
                    <Label x:Name="NotificationStatusLabel"
                           Text="Orders, requests, payments, and system alerts."
                           Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Text="Reload"
                        Style="{StaticResource MiniButton}"
                        Clicked="Reload_Clicked"
                        VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="10">
                <CollectionView ItemsSource="{Binding NotificationItems}">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="No notifications yet" Style="{StaticResource ItemTitle}" HorizontalTextAlignment="Center" />
                                <Label Text="Booking, payment, mechanic, and approval alerts will appear here after the API returns them."
                                       Style="{StaticResource SmallMuted}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" Style="{StaticResource ItemTitle}" />
                                    <Label Text="{Binding Message}" Style="{StaticResource BodyText}" />
                                    <Label Text="{Binding CreatedAtText}" Style="{StaticResource TinyMuted}" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button x:Name="MarkAllButton"
                        Text="Mark All As Read"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="MarkAllAsRead_Clicked" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

