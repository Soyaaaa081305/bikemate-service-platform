<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Admins"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Orange}" Padding="18,18,18,22" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="&lt;" Style="{StaticResource BackButton}" BackgroundColor="White" Clicked="Exit_Clicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Mechanic Application" Style="{StaticResource HeaderTitle}" />
                    <Label x:Name="StepSubtitleLabel" Text="Step 1 of 4 - Account" Style="{StaticResource HeaderSubtitle}" TextColor="#FFF3EA" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="List" Style="{StaticResource MiniButton}" BackgroundColor="White" Clicked="ShowList_Clicked" />
            </Grid>
            <ProgressBar x:Name="StepProgressBar" Progress="0.25" ProgressColor="White" BackgroundColor="#FFC599" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Frame x:Name="AccountStepFrame" Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Account Details" Style="{StaticResource PageTitle}" />
                        <Label Text="Create the mechanic login. The account remains pending until OTP and BikeMate admin approval are complete." Style="{StaticResource SmallMuted}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="FirstNameEntry" Placeholder="First name" Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1" x:Name="MiddleNameEntry" Placeholder="Middle name" Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Entry x:Name="LastNameEntry" Placeholder="Last name" Style="{StaticResource InputEntry}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Picker x:Name="SexPicker" Title="Sex" Style="{StaticResource InputPicker}" />
                            <DatePicker Grid.Column="1" x:Name="BirthdatePicker" />
                        </Grid>

                        <Entry x:Name="EmailEntry"
                               Placeholder="Email address"
                               Keyboard="Email"
                               Text=""
                               IsTextPredictionEnabled="False"
                               Style="{StaticResource InputEntry}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="+63" Style="{StaticResource ItemTitle}" VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   x:Name="PhoneEntry"
                                   Placeholder="9XXXXXXXXX"
                                   Keyboard="Telephone"
                                   MaxLength="10"
                                   Style="{StaticResource InputEntry}"
                                   TextChanged="PhoneEntry_TextChanged" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1" x:Name="ConfirmPasswordEntry" Placeholder="Confirm password" IsPassword="True" Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Label Text="Use more than 8 characters." Style="{StaticResource TinyMuted}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="AddressStepFrame" Style="{StaticResource CardFrame}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Address" Style="{StaticResource PageTitle}" />
                        <Label Text="Use the Philippine location lists so the mechanic profile matches BikeMate service areas." Style="{StaticResource SmallMuted}" />
                        <Label x:Name="LocationStatusLabel" Text="" Style="{StaticResource TinyMuted}" />
                        <Picker x:Name="RegionPicker"
                                Title="Select region"
                                Style="{StaticResource InputPicker}"
                                SelectedIndexChanged="OnRegionChanged" />
                        <Picker x:Name="CityPicker"
                                Title="Select city or municipality"
                                Style="{StaticResource InputPicker}"
                                SelectedIndexChanged="OnCityChanged" />
                        <Label x:Name="ProvinceLabel" Text="" Style="{StaticResource TinyMuted}" />
                        <Picker x:Name="BarangayPicker"
                                Title="Select barangay"
                                Style="{StaticResource InputPicker}" />
                        <Entry x:Name="AddressEntry" Placeholder="House number, street, subdivision" Style="{StaticResource InputEntry}" />
                        <Entry x:Name="ZipCodeEntry" Placeholder="ZIP code" Keyboard="Numeric" MaxLength="4" Style="{StaticResource InputEntry}" />
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="ProfileStepFrame" Style="{StaticResource CardFrame}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Profile and Documents" Style="{StaticResource PageTitle}" />
                        <Label Text="Upload files and review the previews before submitting. These are what BikeMate admin will check." Style="{StaticResource SmallMuted}" />

                        <Grid ColumnDefinitions="*,120" ColumnSpacing="8">
                            <Editor x:Name="BioEditor" Placeholder="Short mechanic background, specialties, and shop role" Style="{StaticResource InputEditor}" />
                            <Entry Grid.Column="1" x:Name="YearsEntry" Placeholder="Years" Keyboard="Numeric" MaxLength="2" Style="{StaticResource InputEntry}" VerticalOptions="Start" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Profile Photo" Style="{StaticResource OutlineButton}" Clicked="PickProfile_Clicked" />
                            <Button Grid.Column="1" Text="Scan ID" Style="{StaticResource OutlineButton}" Clicked="PickValidId_Clicked" />
                        </Grid>
                        <Button Text="Scan License / Certification" Style="{StaticResource OutlineButton}" Clicked="PickCertification_Clicked" />
                        <Label x:Name="FileStatusLabel" Text="No files uploaded yet." Style="{StaticResource SmallMuted}" />
                        <Label x:Name="LocalScanStatusLabel"
                               Text="Verification documents require a fresh camera scan before submission."
                               Style="{StaticResource SmallMuted}" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <Frame Style="{StaticResource SmallCardFrame}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Profile photo" Style="{StaticResource TinyMuted}" />
                                    <Image x:Name="ProfilePreviewImage" HeightRequest="110" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                    <Label x:Name="ProfilePreviewLabel" Text="Not uploaded" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Valid ID" Style="{StaticResource TinyMuted}" />
                                    <Image x:Name="ValidIdPreviewImage" HeightRequest="110" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                    <Label x:Name="ValidIdPreviewLabel" Text="Not uploaded" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SmallCardFrame}">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="License / Certification" Style="{StaticResource TinyMuted}" />
                                    <Image x:Name="CertificationPreviewImage" HeightRequest="130" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                    <Label x:Name="CertificationPreviewLabel" Text="Not uploaded" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>

                        <Frame Style="{StaticResource SmallCardFrame}" BackgroundColor="{StaticResource SoftOrange}" BorderColor="{StaticResource SoftOrange}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <CheckBox x:Name="TermsCheckBox" Color="{StaticResource Orange}" VerticalOptions="Start" />
                                <Label Grid.Column="1"
                                       Text="I confirm this mechanic gave permission to create a BikeMate account, and the submitted ID, license/certification, and contact information are accurate for admin review."
                                       Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </Frame>

                        <Button x:Name="SubmitButton" Text="Submit and Send OTP" Style="{StaticResource PrimaryButton}" Clicked="Submit_Clicked" />
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="OtpStepFrame" Style="{StaticResource CardFrame}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Email Verification" Style="{StaticResource PageTitle}" />
                        <Label Text="Enter the code sent to the mechanic email. After verification, the application becomes ready for BikeMate web-admin review." Style="{StaticResource SmallMuted}" />
                        <Label x:Name="OtpStatusLabel" Text="No mechanic OTP is pending." Style="{StaticResource TinyMuted}" />
                        <Grid ColumnDefinitions="*,116" ColumnSpacing="8">
                            <Entry x:Name="OtpEmailEntry"
                                   Placeholder="Mechanic email"
                                   Keyboard="Email"
                                   Text=""
                                   IsTextPredictionEnabled="False"
                                   Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1" x:Name="OtpEntry" Placeholder="OTP" Keyboard="Numeric" MaxLength="6" Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Verify OTP" Style="{StaticResource PrimaryButton}" Clicked="VerifyOtp_Clicked" />
                            <Button Grid.Column="1" Text="Resend OTP" Style="{StaticResource OutlineButton}" Clicked="ResendOtp_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame x:Name="ListStepFrame" Style="{StaticResource CardFrame}" IsVisible="False">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Mechanic Submissions" Style="{StaticResource PageTitle}" />
                                <Label Text="OTP-pending accounts stay here for follow-up. Verified accounts become visible to BikeMate admin approval." Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Refresh" Style="{StaticResource MiniButton}" Clicked="Refresh_Clicked" />
                        </Grid>

                        <CollectionView x:Name="ApplicationsCollectionView"
                                        ItemsSource="{Binding Applications}"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No mechanic applications submitted from this shop yet." Style="{StaticResource SmallMuted}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Margin="0,4" Style="{StaticResource SmallCardFrame}">
                                        <VerticalStackLayout Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout>
                                                    <Label Text="{Binding FullName}" Style="{StaticResource ItemTitle}" />
                                                    <Label Text="{Binding ShopName}" Style="{StaticResource TinyMuted}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="{Binding StatusText}" TextColor="{Binding StatusColor}" FontAttributes="Bold" FontSize="11" />
                                            </Grid>
                                            <Label Text="{Binding Email}" Style="{StaticResource SmallMuted}" />
                                            <Grid ColumnDefinitions="*,*">
                                                <Label Text="{Binding OtpText}" Style="{StaticResource TinyMuted}" />
                                                <Label Grid.Column="1" Text="{Binding ApprovalText}" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="End" />
                                            </Grid>
                                            <Label Text="{Binding SubmittedText}" Style="{StaticResource TinyMuted}" />
                                            <Button Text="View Details"
                                                    Style="{StaticResource OutlineButton}"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="ViewApplicationDetails_Clicked" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Frame x:Name="ApplicationDetailsFrame"
                               Style="{StaticResource SmallCardFrame}"
                               IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label x:Name="DetailsNameLabel" Text="Mechanic details" Style="{StaticResource ItemTitle}" />
                                        <Label x:Name="DetailsStatusLabel" Text="Status" Style="{StaticResource TinyMuted}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1"
                                            Text="Close"
                                            Style="{StaticResource MiniButton}"
                                            Clicked="CloseApplicationDetails_Clicked" />
                                </Grid>

                                <Frame Style="{StaticResource SmallCardFrame}" BackgroundColor="{StaticResource SoftGray}" BorderColor="{StaticResource SoftGray}">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Submitted information" Style="{StaticResource SectionLabel}" Margin="0" />
                                        <Label x:Name="DetailsContactLabel" Style="{StaticResource SmallMuted}" />
                                        <Label x:Name="DetailsPersonalLabel" Style="{StaticResource SmallMuted}" />
                                        <Label x:Name="DetailsAddressLabel" Style="{StaticResource SmallMuted}" />
                                        <Label x:Name="DetailsExperienceLabel" Style="{StaticResource SmallMuted}" />
                                        <Label x:Name="DetailsBioLabel" Style="{StaticResource SmallMuted}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Frame>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Frame Style="{StaticResource SmallCardFrame}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="Profile photo" Style="{StaticResource TinyMuted}" />
                                            <Image x:Name="DetailsProfileImage" HeightRequest="120" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                            <Label x:Name="DetailsProfileLabel" Text="Not submitted" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="Valid ID" Style="{StaticResource TinyMuted}" />
                                            <Image x:Name="DetailsValidIdImage" HeightRequest="120" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                            <Label x:Name="DetailsValidIdLabel" Text="Not submitted" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Frame>
                                    <Frame Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SmallCardFrame}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="License / certification" Style="{StaticResource TinyMuted}" />
                                            <Image x:Name="DetailsCertificationImage" HeightRequest="140" Aspect="AspectFill" BackgroundColor="{StaticResource SoftGray}" />
                                            <Label x:Name="DetailsCertificationLabel" Text="Not submitted" Style="{StaticResource TinyMuted}" HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Padding="14,10" BackgroundColor="White">
            <Button x:Name="BackStepButton" Text="Back" Style="{StaticResource OutlineButton}" Clicked="BackStep_Clicked" />
            <Button x:Name="NextStepButton" Grid.Column="1" Text="Continue" Style="{StaticResource PrimaryButton}" Clicked="NextStep_Clicked" />
        </Grid>
    </Grid>

</ContentPage>
