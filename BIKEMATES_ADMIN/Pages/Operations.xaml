<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Operations"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Services" Style="{StaticResource HeaderTitle}" />
                    <Label Text="Manage repair offers, pricing, duration, and availability." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Back" Style="{StaticResource MiniButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Service Editor" Style="{StaticResource SectionLabel}" />
                        <Label x:Name="ServiceEditorStatusLabel"
                               Text="Select a service below to update it, or enter new details to add a shop service."
                               Style="{StaticResource SmallMuted}" />
                        <SearchBar x:Name="ServiceCategorySearchBar"
                                   Placeholder="Search service category"
                                   Style="{StaticResource SearchInput}"
                                   TextChanged="ServiceCategorySearchBar_TextChanged" />
                        <Picker x:Name="CategoryPicker"
                                Title="Service category"
                                Style="{StaticResource InputPicker}" />
                        <Button Text="Add Category" Style="{StaticResource OutlineButton}" Clicked="AddServiceCategory_Clicked" />
                        <Entry x:Name="ServiceNameEntry"
                               Placeholder="Service name"
                               Style="{StaticResource InputEntry}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="PriceEntry"
                                   Placeholder="Base price"
                                   Keyboard="Numeric"
                                   Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1"
                                   x:Name="DurationEntry"
                                   Placeholder="Minutes"
                                   Keyboard="Numeric"
                                   Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="What is included in this service?"
                                Style="{StaticResource InputEditor}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Available for customer booking"
                                   Style="{StaticResource BodyText}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    x:Name="ActiveSwitch"
                                    IsToggled="True"
                                    VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Add" Style="{StaticResource PrimaryButton}" Clicked="AddService_Clicked" />
                            <Button Grid.Column="1" Text="Update" Style="{StaticResource DarkButton}" Clicked="UpdateService_Clicked" />
                            <Button Grid.Column="2" Text="Deactivate" Style="{StaticResource DangerButton}" Clicked="DeleteService_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Shop Services" Style="{StaticResource SectionLabel}" />
                        <Label Text="These are the services customers can select after choosing your shop." Style="{StaticResource SmallMuted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding ServiceItems.Count, StringFormat='{0} services'}"
                           Style="{StaticResource Pill}"
                           VerticalOptions="Center" />
                </Grid>

                <SearchBar x:Name="ServiceSearchBar"
                           Placeholder="Search services"
                           Style="{StaticResource SearchInput}"
                           TextChanged="ServiceSearchBar_TextChanged" />

                <CollectionView x:Name="ServicesCollectionView"
                                ItemsSource="{Binding VisibleServices}"
                                SelectionMode="Single"
                                SelectionChanged="ServicesCollectionView_SelectionChanged">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <Label Text="No shop services returned by the API yet. Add one above so customers can book it." Style="{StaticResource SmallMuted}" />
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,4" Style="{StaticResource SmallCardFrame}">
                                <VerticalStackLayout Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               BackgroundColor="{Binding StatusColor}"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               Padding="8,4" />
                                    </Grid>
                                    <Label Text="{Binding CategoryName}" Style="{StaticResource TinyMuted}" />
                                    <Label Text="{Binding Description}" Style="{StaticResource SmallMuted}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding PriceText}" TextColor="{StaticResource Orange}" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource TinyMuted}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
