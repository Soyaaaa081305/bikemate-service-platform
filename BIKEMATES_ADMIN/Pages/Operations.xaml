<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Operations"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&lt;" Style="{StaticResource BackButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Services" Style="{StaticResource HeaderTitle}" />
                    <Label Text="Manage bookable shop offers." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Service Editor" Style="{StaticResource SectionLabel}" />
                                <Label x:Name="ServiceEditorStatusLabel"
                                       Text="Add a bookable service, or choose one below to edit price, duration, and availability."
                                       Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Clear" Style="{StaticResource OutlineButton}" Clicked="ClearServiceEditor_Clicked" VerticalOptions="Center" />
                        </Grid>

                        <Frame Style="{StaticResource SmallCardFrame}" BackgroundColor="{StaticResource SoftGray}" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Category" Style="{StaticResource TinyMuted}" />
                                <SearchBar x:Name="ServiceCategorySearchBar"
                                           Placeholder="Search existing categories"
                                           Style="{StaticResource SearchInput}"
                                           TextChanged="ServiceCategorySearchBar_TextChanged" />
                                <Picker x:Name="CategoryPicker"
                                        Title="Service category"
                                        Style="{StaticResource InputPicker}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Entry x:Name="ServiceCategoryNameEntry"
                                           Placeholder="New category"
                                           Style="{StaticResource InputEntry}" />
                                    <Button Grid.Column="1" Text="Add" Style="{StaticResource MiniButton}" Clicked="AddServiceCategory_Clicked" />
                                    <Button Grid.Column="2" Text="Delete" Style="{StaticResource DangerButton}" Clicked="DeleteServiceCategory_Clicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <Entry x:Name="ServiceNameEntry"
                               Placeholder="Service name"
                               Style="{StaticResource InputEntry}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Entry x:Name="PriceEntry"
                                   Placeholder="Base price"
                                   Keyboard="Numeric"
                                   Style="{StaticResource InputEntry}" />
                            <Entry Grid.Column="1"
                                   x:Name="DurationEntry"
                                   Placeholder="Minutes"
                                   Keyboard="Numeric"
                                   Style="{StaticResource InputEntry}" />
                        </Grid>
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="What is included in this service?"
                                Style="{StaticResource InputEditor}" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Available for customer booking" Style="{StaticResource BodyText}" />
                                <Label Text="Turn this off to keep the service hidden." Style="{StaticResource TinyMuted}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    x:Name="ActiveSwitch"
                                    IsToggled="True"
                                    VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Add" Style="{StaticResource PrimaryButton}" Clicked="AddService_Clicked" />
                            <Button Grid.Column="1" Text="Update" Style="{StaticResource DarkButton}" Clicked="UpdateService_Clicked" />
                            <Button Grid.Column="2" Text="Deactivate" Style="{StaticResource DangerButton}" Clicked="DeleteService_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Shop Services" Style="{StaticResource SectionLabel}" />
                        <Label Text="Services customers can choose after selecting your shop." Style="{StaticResource SmallMuted}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding VisibleServices.Count, StringFormat='{0} shown'}"
                           Style="{StaticResource Pill}"
                           VerticalOptions="Center" />
                </Grid>

                <SearchBar x:Name="ServiceSearchBar"
                           Placeholder="Search services"
                           Style="{StaticResource SearchInput}"
                           TextChanged="ServiceSearchBar_TextChanged" />

                <CollectionView x:Name="ServicesCollectionView"
                                ItemsSource="{Binding VisibleServices}"
                                SelectionMode="Single"
                                SelectionChanged="ServicesCollectionView_SelectionChanged">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="No services in this view" Style="{StaticResource ItemTitle}" HorizontalTextAlignment="Center" />
                                <Label Text="Clear search or add a service customers can book after selecting your shop."
                                       Style="{StaticResource SmallMuted}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                                <Button Text="Clear search"
                                        Style="{StaticResource OutlineButton}"
                                        Clicked="ClearServiceSearch_Clicked" />
                            </VerticalStackLayout>
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,4" Style="{StaticResource SmallCardFrame}">
                                <Grid ColumnDefinitions="*,96" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding StatusText}"
                                                   BackgroundColor="{Binding StatusColor}"
                                                   TextColor="White"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   Padding="8,4" />
                                        </Grid>
                                        <Label Text="{Binding CategoryName}" Style="{StaticResource TinyMuted}" />
                                        <Label Text="{Binding Description}" Style="{StaticResource SmallMuted}" MaxLines="2" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding PriceText}" TextColor="{StaticResource Orange}" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource TinyMuted}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                                        <Button Text="Edit"
                                                Style="{StaticResource OutlineButton}"
                                                CommandParameter="{Binding .}"
                                                Clicked="EditService_Clicked" />
                                        <Button Text="Deactivate"
                                                Style="{StaticResource DangerButton}"
                                                CommandParameter="{Binding .}"
                                                Clicked="DeleteServiceRow_Clicked" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
