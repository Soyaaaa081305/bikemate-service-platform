<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Reports"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reports" Style="{StaticResource HeaderTitle}" />
                    <Label Text="Performance insights and analytics." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Exit" Style="{StaticResource MiniButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Frame Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="PHP 0.00" Style="{StaticResource StatNumber}" /><Label Text="Monthly Revenue" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}"><VerticalStackLayout><Label Text="0%" Style="{StaticResource StatNumber}" /><Label Text="Completion Rate" Style="{StaticResource SmallMuted}" /></VerticalStackLayout></Frame>
                </Grid>

                <Label Text="Top Services" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <Label Text="No service analytics returned by the API yet." Style="{StaticResource SmallMuted}" />
                </Frame>

                <Label Text="Customer Ratings" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <Label Text="Customer ratings will appear after completed bookings are returned by the API." Style="{StaticResource SmallMuted}" />
                </Frame>

                <Button Text="Export Report" Style="{StaticResource PrimaryButton}" IsEnabled="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
