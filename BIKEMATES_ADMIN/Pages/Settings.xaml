<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Settings"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*"><VerticalStackLayout BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18"><Label Text="Settings" Style="{StaticResource HeaderTitle}"/><Label Text="Shop preferences and configurations." Style="{StaticResource HeaderSubtitle}"/></VerticalStackLayout><ScrollView Grid.Row="1"><VerticalStackLayout Padding="14,12,14,30" Spacing="14"><Label Text="SHOP SETTINGS" Style="{StaticResource SectionLabel}"/><Frame Style="{StaticResource CardFrame}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><Label Text="Accept service requests" Style="{StaticResource BodyText}"/><Switch Grid.Column="1" IsToggled="True"/></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Auto-assign available mechanic" Style="{StaticResource BodyText}"/><Switch Grid.Column="1"/></Grid><Grid ColumnDefinitions="*,Auto"><Label Text="Notify on low stock" Style="{StaticResource BodyText}"/><Switch Grid.Column="1" IsToggled="True"/></Grid></VerticalStackLayout></Frame><Label Text="PAYMENT" Style="{StaticResource SectionLabel}"/><Frame Style="{StaticResource CardFrame}"><VerticalStackLayout Spacing="8"><Label Text="PayMongo: Connected" TextColor="{StaticResource Green}" FontAttributes="Bold"/><Button Text="Update Payment Settings" Style="{StaticResource OutlineButton}"/></VerticalStackLayout></Frame><Label Text="SECURITY" Style="{StaticResource SectionLabel}"/><Frame Style="{StaticResource CardFrame}"><VerticalStackLayout Spacing="8"><Button Text="Change Password" Style="{StaticResource OutlineButton}"/><Button Text="Manage Login Sessions" Style="{StaticResource OutlineButton}"/></VerticalStackLayout></Frame></VerticalStackLayout></ScrollView></Grid>

</ContentPage>
