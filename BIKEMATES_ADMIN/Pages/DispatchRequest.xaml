<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.DispatchRequest"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Dispatch &amp; Requests" Style="{StaticResource HeaderTitle}" />
                    <Label Text="View customer requests, mechanic status, and assignments." Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Exit" Style="{StaticResource MiniButton}" Clicked="Exit_Clicked" VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,12,14,30" Spacing="14">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Mechanic Status Legend" Style="{StaticResource SectionLabel}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <HorizontalStackLayout Spacing="8"><BoxView Color="{StaticResource StatusUnavailable}" WidthRequest="14" HeightRequest="14" CornerRadius="7"/><Label Text="Red - Unavailable" Style="{StaticResource SmallMuted}"/></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8"><BoxView Color="{StaticResource StatusAvailable}" WidthRequest="14" HeightRequest="14" CornerRadius="7"/><Label Text="Green - Available" Style="{StaticResource SmallMuted}"/></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Spacing="8"><BoxView Color="{StaticResource StatusDispatched}" WidthRequest="14" HeightRequest="14" CornerRadius="7"/><Label Text="Orange - Dispatched" Style="{StaticResource SmallMuted}"/></HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8"><BoxView Color="{StaticResource StatusArrived}" WidthRequest="14" HeightRequest="14" CornerRadius="7"/><Label Text="Yellow - Arrived" Style="{StaticResource SmallMuted}"/></HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Available Mechanics" Style="{StaticResource SectionLabel}" />
                <CollectionView x:Name="MechanicsCollectionView" ItemsSource="{Binding Mechanics}" SelectionMode="Single" SelectionChanged="MechanicsCollectionView_SelectionChanged" HeightRequest="142">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <Label Text="No mechanics returned by the shop/mechanics API yet." Style="{StaticResource SmallMuted}" />
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Horizontal" /></CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="4" WidthRequest="128" Style="{StaticResource SmallCardFrame}" BorderColor="{Binding StatusColor}">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Frame WidthRequest="48" HeightRequest="48" CornerRadius="16" Padding="0" BackgroundColor="{Binding StatusColor}" HasShadow="False">
                                        <Label Text="{Binding Initials}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" HorizontalTextAlignment="Center" />
                                    <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Customer Requests" Style="{StaticResource SectionLabel}" />
                <CollectionView x:Name="RequestsCollectionView" ItemsSource="{Binding Requests}" SelectionMode="Single" SelectionChanged="RequestsCollectionView_SelectionChanged" HeightRequest="245">
                    <CollectionView.EmptyView>
                        <Frame Style="{StaticResource CardFrame}">
                            <Label Text="No customer service requests returned by the shop/bookings API yet." Style="{StaticResource SmallMuted}" />
                        </Frame>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,4" Style="{StaticResource SmallCardFrame}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                    <Label Text="{Binding CustomerName}" Style="{StaticResource ItemTitle}" />
                                    <Label Grid.Column="1" Text="{Binding Priority}" TextColor="White" BackgroundColor="{Binding PriorityColor}" Padding="8,4" FontSize="10" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Text="{Binding RequestType}" Style="{StaticResource SmallMuted}" />
                                    <Label Grid.Row="2" Text="{Binding Address}" Style="{StaticResource TinyMuted}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dispatch Actions" Style="{StaticResource SectionLabel}" />
                        <Label x:Name="SelectedDispatchLabel" Text="Select a mechanic and request first." Style="{StaticResource SmallMuted}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Assign Mechanic" Style="{StaticResource PrimaryButton}" Clicked="AssignMechanic_Clicked" />
                            <Button Grid.Column="1" Text="View Details" Style="{StaticResource DarkButton}" Clicked="ViewDispatchDetails_Clicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Mark Arrived" Style="{StaticResource OutlineButton}" Clicked="MarkArrived_Clicked" />
                            <Button Grid.Column="1" Text="Set Available" Style="{StaticResource OutlineButton}" Clicked="SetAvailable_Clicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

