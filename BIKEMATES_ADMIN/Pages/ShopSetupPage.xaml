<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.ShopSetupPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="{StaticResource Navy}"
                             Padding="18,16,18,18"
                             Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Complete Shop Setup" Style="{StaticResource HeaderTitle}" />
                    <Label x:Name="SetupHeaderSubtitle" Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Sign out"
                        Style="{StaticResource MiniButton}"
                        Clicked="SignOut_Clicked"
                        VerticalOptions="Center" />
            </Grid>
        </VerticalStackLayout>

        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Padding="14,12,14,20" Spacing="14">
                    <Frame Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label x:Name="ShopNameLabel" Style="{StaticResource PageTitle}" />
                            <Label x:Name="StepTitleLabel" Style="{StaticResource SectionLabel}" />
                            <Label x:Name="SetupStatusLabel" Style="{StaticResource SmallMuted}" />
                            <ProgressBar x:Name="SetupProgress" ProgressColor="{StaticResource Orange}" />

                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                <Label x:Name="IdentityStepIndicator" Text="1. Identity" Style="{StaticResource TinyMuted}" />
                                <Label Grid.Column="1" x:Name="ProductsStepIndicator" Text="2. Products" Style="{StaticResource TinyMuted}" />
                                <Label Grid.Column="2" x:Name="ServicesStepIndicator" Text="3. Services" Style="{StaticResource TinyMuted}" />
                                <Label Grid.Column="3" x:Name="ReviewStepIndicator" Text="4. Review" Style="{StaticResource TinyMuted}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Label x:Name="CoverStepLabel" Style="{StaticResource SmallMuted}" />
                                <Label Grid.Column="1" x:Name="LogoStepLabel" Style="{StaticResource SmallMuted}" />
                                <Label Grid.Row="1" x:Name="DescriptionStepLabel" Style="{StaticResource SmallMuted}" />
                                <Label Grid.Row="1" Grid.Column="1" x:Name="ProductsStepLabel" Style="{StaticResource SmallMuted}" />
                                <Label Grid.Row="2" x:Name="ServicesStepLabel" Style="{StaticResource SmallMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame x:Name="IdentityStepFrame" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Shop Identity" Style="{StaticResource SectionLabel}" />
                            <Label Text="Set the public photos and short description customers will see first." Style="{StaticResource SmallMuted}" />

                            <Frame HeightRequest="150"
                                   CornerRadius="14"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="{StaticResource LineColor}"
                                   BackgroundColor="{StaticResource SoftGray}">
                                <Grid>
                                    <Image x:Name="CoverImage" Aspect="AspectFill" />
                                    <Label x:Name="CoverPlaceholder"
                                           Text="Cover photo"
                                           Style="{StaticResource SmallMuted}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Frame>

                            <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                <Frame WidthRequest="96"
                                       HeightRequest="96"
                                       CornerRadius="48"
                                       Padding="0"
                                       HasShadow="False"
                                       BorderColor="{StaticResource LineColor}"
                                       BackgroundColor="{StaticResource SoftGray}">
                                    <Grid>
                                        <Image x:Name="LogoImage" Aspect="AspectFill" />
                                        <Label x:Name="LogoPlaceholder"
                                               Text="Logo"
                                               Style="{StaticResource SmallMuted}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Button Text="Choose Cover Photo"
                                            Style="{StaticResource OutlineButton}"
                                            Clicked="ChooseCover_Clicked" />
                                    <Button Text="Choose Profile Picture"
                                            Style="{StaticResource OutlineButton}"
                                            Clicked="ChooseLogo_Clicked" />
                                </VerticalStackLayout>
                            </Grid>

                            <Editor x:Name="DescriptionEditor"
                                    Placeholder="Short shop description, specialties, and customer promise"
                                    Style="{StaticResource InputEditor}" />
                            <Button x:Name="SaveIdentityButton"
                                    Text="Save Shop Identity"
                                    Style="{StaticResource PrimaryButton}"
                                    Clicked="SaveIdentity_Clicked" />
                        </VerticalStackLayout>
                    </Frame>

                    <Frame x:Name="ProductsStepFrame" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Products" Style="{StaticResource SectionLabel}" />
                            <Label Text="Add products, parts, or upgrades customers can choose for modification bookings." Style="{StaticResource SmallMuted}" />
                            <Entry x:Name="ProductNameEntry" Placeholder="Product name" Style="{StaticResource InputEntry}" />
                            <SearchBar x:Name="ProductCategorySearchBar"
                                       Placeholder="Search product category"
                                       Style="{StaticResource SearchInput}"
                                       TextChanged="ProductCategorySearchBar_TextChanged" />
                            <Picker x:Name="ProductCategoryPicker" Title="Product category" Style="{StaticResource InputPicker}" />
                            <Button Text="Add Product Category" Style="{StaticResource OutlineButton}" Clicked="AddProductCategory_Clicked" />
                            <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                <Frame WidthRequest="96"
                                       HeightRequest="96"
                                       CornerRadius="16"
                                       Padding="0"
                                       HasShadow="False"
                                       BorderColor="{StaticResource LineColor}"
                                       BackgroundColor="{StaticResource SoftGray}">
                                    <Grid>
                                        <Image x:Name="ProductImage" Aspect="AspectFill" />
                                        <Label x:Name="ProductImagePlaceholder"
                                               Text="Image"
                                               Style="{StaticResource SmallMuted}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                                <Button Grid.Column="1"
                                        Text="Choose Product Image"
                                        Style="{StaticResource OutlineButton}"
                                        Clicked="ChooseProductImage_Clicked"
                                        VerticalOptions="Center" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Entry x:Name="ProductPriceEntry" Placeholder="Price" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                                <Entry Grid.Column="1" x:Name="ProductStockEntry" Placeholder="Stock" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                            </Grid>
                            <Editor x:Name="ProductDescriptionEditor" Placeholder="Product description" Style="{StaticResource InputEditor}" />
                            <Button Text="Add Product" Style="{StaticResource PrimaryButton}" Clicked="AddProduct_Clicked" />
                            <Label Text="Products added" Style="{StaticResource SectionLabel}" />
                            <CollectionView ItemsSource="{Binding SetupProducts}" HeightRequest="210">
                                <CollectionView.EmptyView>
                                    <Label Text="No products added yet." Style="{StaticResource SmallMuted}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnDefinitions="64,*,Auto" ColumnSpacing="10">
                                            <Image Source="{Binding ProductImage}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="56"
                                                   HeightRequest="56" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                <Label Text="{Binding Category}" Style="{StaticResource TinyMuted}" />
                                                <Label Text="{Binding StockText}" Style="{StaticResource TinyMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{Binding PriceText}"
                                                   TextColor="{StaticResource Orange}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame x:Name="ServicesStepFrame" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Services" Style="{StaticResource SectionLabel}" />
                            <Label Text="Add bookable services with clear pricing and estimated work time." Style="{StaticResource SmallMuted}" />
                            <SearchBar x:Name="ServiceCategorySearchBar"
                                       Placeholder="Search service category"
                                       Style="{StaticResource SearchInput}"
                                       TextChanged="ServiceCategorySearchBar_TextChanged" />
                            <Picker x:Name="ServiceCategoryPicker" Title="Service category" Style="{StaticResource InputPicker}" />
                            <Button Text="Add Service Category" Style="{StaticResource OutlineButton}" Clicked="AddServiceCategory_Clicked" />
                            <Entry x:Name="ServiceNameEntry" Placeholder="Service name" Style="{StaticResource InputEntry}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Entry x:Name="ServicePriceEntry" Placeholder="Base price" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                                <Entry Grid.Column="1" x:Name="ServiceMinutesEntry" Placeholder="Minutes" Keyboard="Numeric" Style="{StaticResource InputEntry}" />
                            </Grid>
                            <Editor x:Name="ServiceDescriptionEditor" Placeholder="What is included in this service?" Style="{StaticResource InputEditor}" />
                            <Button Text="Add Service" Style="{StaticResource PrimaryButton}" Clicked="AddService_Clicked" />
                            <Label Text="Services added" Style="{StaticResource SectionLabel}" />
                            <CollectionView ItemsSource="{Binding SetupServices}" HeightRequest="210">
                                <CollectionView.EmptyView>
                                    <Label Text="No services added yet." Style="{StaticResource SmallMuted}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding ServiceName}" Style="{StaticResource ItemTitle}" />
                                                <Label Text="{Binding CategoryName}" Style="{StaticResource TinyMuted}" />
                                                <Label Text="{Binding DurationText}" Style="{StaticResource TinyMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   TextColor="{StaticResource Orange}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>

                    <Frame x:Name="ReviewStepFrame" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Review Setup" Style="{StaticResource SectionLabel}" />
                            <Label Text="Confirm the shop is ready before opening the dashboard." Style="{StaticResource SmallMuted}" />
                            <Label x:Name="ReviewIdentityLabel" Style="{StaticResource SmallMuted}" />
                            <Label x:Name="ReviewProductCountLabel" Style="{StaticResource SmallMuted}" />
                            <Label x:Name="ReviewServiceCountLabel" Style="{StaticResource SmallMuted}" />

                            <Label Text="Products" Style="{StaticResource SectionLabel}" />
                            <CollectionView ItemsSource="{Binding SetupProducts}" HeightRequest="150">
                                <CollectionView.EmptyView>
                                    <Label Text="No products added yet." Style="{StaticResource SmallMuted}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                <Label Text="{Binding Category}" Style="{StaticResource TinyMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   TextColor="{StaticResource Orange}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <Label Text="Services" Style="{StaticResource SectionLabel}" />
                            <CollectionView ItemsSource="{Binding SetupServices}" HeightRequest="150">
                                <CollectionView.EmptyView>
                                    <Label Text="No services added yet." Style="{StaticResource SmallMuted}" />
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding ServiceName}" Style="{StaticResource ItemTitle}" />
                                                <Label Text="{Binding CategoryName}" Style="{StaticResource TinyMuted}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding PriceText}"
                                                   TextColor="{StaticResource Orange}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1"
                  Padding="14,10,14,14"
                  BackgroundColor="{StaticResource PageBg}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="10">
                <Button x:Name="BackStepButton"
                        Text="Back"
                        Style="{StaticResource OutlineButton}"
                        Clicked="BackStep_Clicked" />
                <Button x:Name="NextStepButton"
                        Grid.Column="1"
                        Text="Next"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="NextStep_Clicked" />
                <Button x:Name="ContinueButton"
                        Grid.Column="1"
                        Text="Open Dashboard"
                        Style="{StaticResource DarkButton}"
                        Clicked="Continue_Clicked" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
