<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Messages"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0"
              Padding="18,16,18,18"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12"
              BackgroundColor="{StaticResource Navy}">
            <Button Text="&lt;"
                    Style="{StaticResource BackButton}"
                    Clicked="Exit_Clicked"
                    VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Messages"
                       TextColor="White"
                       FontFamily="Inter"
                       FontSize="18"
                       FontAttributes="Bold" />
                <Label Text="Customer, BikeMate admin, and mechanic conversations"
                       TextColor="#CBD5E1"
                       FontFamily="PublicSans"
                       FontSize="11" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="Reload"
                    Style="{StaticResource MiniButton}"
                    Clicked="Reload_Clicked"
                    VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="14,12,14,8" Spacing="10">
            <Frame Style="{StaticResource CardFrame}" Padding="10,0">
                <SearchBar x:Name="ConversationSearchBar"
                           Placeholder="Search name, message, or booking ID"
                           Style="{StaticResource SearchInput}"
                           TextChanged="SearchBar_TextChanged" />
            </Frame>

            <Frame Style="{StaticResource CardFrame}" Padding="4">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" HeightRequest="42">
                    <Button x:Name="CustomerTabButton"
                            Text="Customers"
                            Style="{StaticResource MessengerTab}"
                            Clicked="CustomerTab_Clicked" />
                    <Button x:Name="AdminTabButton"
                            Grid.Column="1"
                            Text="BikeMate"
                            Style="{StaticResource MessengerTab}"
                            Clicked="AdminTab_Clicked" />
                    <Button x:Name="MechanicTabButton"
                            Grid.Column="2"
                            Text="Mechanics"
                            Style="{StaticResource MessengerTab}"
                            Clicked="MechanicTab_Clicked" />
                </Grid>
            </Frame>
        </VerticalStackLayout>

        <Grid Grid.Row="2"
              Padding="14,0,14,8"
              RowDefinitions="190,*"
              RowSpacing="10">
            <Frame Grid.Row="0" Style="{StaticResource CardFrame}" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="14,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Threads" Style="{StaticResource ItemTitle}" />
                            <Label Text="Select one conversation to reply." Style="{StaticResource TinyMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="{Binding VisibleConversations.Count, StringFormat='{0} shown'}"
                               Style="{StaticResource Pill}"
                               VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1"
                                    x:Name="ConversationCollectionView"
                                    ItemsSource="{Binding VisibleConversations}"
                                    SelectionMode="Single"
                                    SelectionChanged="ConversationCollectionView_SelectionChanged">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="18" Spacing="4">
                                <Label Text="No conversations in this view"
                                       Style="{StaticResource ItemTitle}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Try another tab, clear search, or reload. Booking messages appear after customers start a request."
                                       Style="{StaticResource SmallMuted}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,9"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="10"
                                      BackgroundColor="White">
                                    <Frame WidthRequest="42"
                                           HeightRequest="42"
                                           CornerRadius="21"
                                           Padding="0"
                                           BackgroundColor="{Binding AvatarColor}"
                                           HasShadow="False">
                                        <Label Text="{Binding Initials}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontFamily="Inter"
                                               FontSize="13"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource ItemTitle}"
                                                   MaxLines="1"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding BadgeText}"
                                                   TextColor="{Binding BadgeTextColor}"
                                                   BackgroundColor="{Binding BadgeColor}"
                                                   FontSize="11"
                                                   FontFamily="PTSansCaptionBold"
                                                   FontAttributes="Bold"
                                                   Padding="7,2" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding DetailLine}"
                                               Style="{StaticResource TinyMuted}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding PreviewText}"
                                               Style="{StaticResource SmallMuted}"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End" VerticalOptions="Center">
                                        <Label Text="{Binding Time}"
                                               Style="{StaticResource TinyMuted}"
                                               HorizontalTextAlignment="End" />
                                        <Label Text="{Binding UnreadText}"
                                               TextColor="White"
                                               BackgroundColor="{StaticResource Orange}"
                                               FontSize="11"
                                               FontFamily="PTSansCaptionBold"
                                               FontAttributes="Bold"
                                               Padding="7,3"
                                               HorizontalTextAlignment="Center"
                                               IsVisible="{Binding HasUnread}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>

            <Frame Grid.Row="1" Style="{StaticResource CardFrame}" Padding="0">
                <Grid RowDefinitions="Auto,*">
                    <Grid BackgroundColor="White"
                          Padding="14"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10">
                        <Frame WidthRequest="42"
                               HeightRequest="42"
                               CornerRadius="21"
                               Padding="0"
                               BackgroundColor="{StaticResource Orange}"
                               HasShadow="False">
                            <Label x:Name="ChatAvatarLabel"
                                   Text="BM"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontFamily="Inter"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="ChatNameLabel"
                                   Text="No conversation selected"
                                   Style="{StaticResource ItemTitle}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                            <Label x:Name="ChatStatusLabel"
                                   Text="Select a thread to view messages from the API."
                                   Style="{StaticResource TinyMuted}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               x:Name="ChatBadgeLabel"
                               Text="CHAT"
                               TextColor="{StaticResource OrangeDark}"
                               BackgroundColor="{StaticResource SoftOrange}"
                               FontSize="11"
                               FontFamily="PTSansCaptionBold"
                               FontAttributes="Bold"
                               Padding="8,4"
                               VerticalOptions="Center" />
                    </Grid>

                    <ScrollView Grid.Row="1"
                                Padding="14"
                                BackgroundColor="{StaticResource SoftGray}">
                        <VerticalStackLayout x:Name="ChatThreadLayout" Spacing="9" />
                    </ScrollView>
                </Grid>
            </Frame>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              Padding="14,10"
              BackgroundColor="White">
            <Entry x:Name="ReplyEntry"
                   Placeholder="Type a reply"
                   Style="{StaticResource InputEntry}"
                   Margin="0"
                   IsEnabled="False" />
            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Text="Send"
                    Style="{StaticResource PrimaryButton}"
                    WidthRequest="86"
                    IsEnabled="False"
                    Clicked="SendReply_Clicked" />
        </Grid>
    </Grid>

</ContentPage>
