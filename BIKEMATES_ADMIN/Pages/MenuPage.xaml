<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.MenuPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" BackgroundColor="{StaticResource PageBg}">
            <Grid BackgroundColor="{StaticResource Orange}"
                  Padding="18,24,18,54"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
                <Frame WidthRequest="52"
                       HeightRequest="52"
                       CornerRadius="18"
                       Padding="0"
                       BackgroundColor="White"
                       HasShadow="False">
                    <Label x:Name="InitialsLabel"
                           Text="AD"
                           TextColor="{StaticResource OrangeDark}"
                           FontAttributes="Bold"
                           FontFamily="Inter"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label x:Name="AdminNameLabel"
                           Text="Admin"
                           Style="{StaticResource HeaderTitle}"
                           LineBreakMode="TailTruncation" />
                    <Label x:Name="AdminShopLabel"
                           Text="No assigned bike shop yet"
                           Style="{StaticResource HeaderSubtitle}"
                           TextColor="#FFF3EA"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Sign out"
                        Style="{StaticResource MiniButton}"
                        BackgroundColor="White"
                        Clicked="SignOut_Clicked" />
            </Grid>

            <Frame Style="{StaticResource CardFrame}"
                   Margin="14,-34,14,0"
                   Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Shop Admin Menu" Style="{StaticResource PageTitle}" />
                        <Label Text="Your command center for booking flow, catalog readiness, mechanics, and account support."
                               Style="{StaticResource SmallMuted}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="Home"
                            Style="{StaticResource MiniButton}"
                            Clicked="Home_Clicked" />
                </Grid>
            </Frame>

            <VerticalStackLayout Padding="14,14,14,30" Spacing="14">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="SHOP" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Button Text="Profile" Style="{StaticResource OutlineButton}" Clicked="ShopProfile_Clicked" />
                        <Button Text="Products" Style="{StaticResource OutlineButton}" Clicked="Products_Clicked" />
                        <Button Text="Services" Style="{StaticResource OutlineButton}" Clicked="Operations_Clicked" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="OPERATIONS" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Button Text="Bookings Queue" Style="{StaticResource OutlineButton}" Clicked="Calendar_Clicked" />
                        <Button Text="Mechanics" Style="{StaticResource OutlineButton}" Clicked="Admins_Clicked" />
                        <Button Text="Messages" Style="{StaticResource OutlineButton}" Clicked="Messages_Clicked" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="BUSINESS" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Button Text="Sales" Style="{StaticResource OutlineButton}" Clicked="Logistics_Clicked" />
                        <Button Text="Reports" Style="{StaticResource OutlineButton}" Clicked="Reports_Clicked" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="ACCOUNT" Style="{StaticResource SectionLabel}" Margin="0" />
                        <Button Text="Notifications" Style="{StaticResource OutlineButton}" Clicked="Notifications_Clicked" />
                        <Button Text="Settings" Style="{StaticResource OutlineButton}" Clicked="Settings_Clicked" />
                        <Button Text="Help" Style="{StaticResource OutlineButton}" Clicked="Help_Clicked" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
