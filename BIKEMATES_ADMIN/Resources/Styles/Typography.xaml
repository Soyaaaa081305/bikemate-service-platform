<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- BIKE MATES ADMIN TYPOGRAPHY + THEME
         Merge this file before AdminStyles.xaml in App.xaml.
         Keep all font sizes, colors, and label styles here so every page stays consistent. -->

    <Color x:Key="Navy">#21313F</Color>
    <Color x:Key="NavySoft">#2B3E4E</Color>
    <Color x:Key="Orange">#FF8A3D</Color>
    <Color x:Key="OrangeDark">#F97316</Color>
    <Color x:Key="PageBg">#F3F4F6</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="TextDark">#1F2937</Color>
    <Color x:Key="MutedText">#8A94A6</Color>
    <Color x:Key="LineColor">#E5E7EB</Color>

    <Color x:Key="Green">#16A34A</Color>
    <Color x:Key="Red">#DC2626</Color>
    <Color x:Key="Blue">#2563EB</Color>
    <Color x:Key="Violet">#7C3AED</Color>
    <Color x:Key="Yellow">#CA8A04</Color>
    <Color x:Key="StatusAvailable">#16A34A</Color>
    <Color x:Key="StatusUnavailable">#DC2626</Color>
    <Color x:Key="StatusDispatched">#FF8A3D</Color>
    <Color x:Key="StatusArrived">#CA8A04</Color>

    <Color x:Key="SoftOrange">#FFF3E8</Color>
    <Color x:Key="SoftGreen">#F0FDF4</Color>
    <Color x:Key="SoftBlue">#EFF6FF</Color>
    <Color x:Key="SoftRed">#FEF2F2</Color>
    <Color x:Key="SoftViolet">#F5F3FF</Color>
    <Color x:Key="SoftYellow">#FEFCE8</Color>
    <Color x:Key="SoftGray">#F9FAFB</Color>

    <!-- Default typography -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="AppTitle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="HeaderTitle" TargetType="Label">
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="HeaderSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="#B8C0CC" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="TextColor" Value="#6B7280" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="Margin" Value="2,8,0,2" />
    </Style>

    <Style x:Key="ItemTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SmallMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="TinyMuted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedText}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="StatNumber" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextDark}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

</ResourceDictionary>

