<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Admins"
             BackgroundColor="{StaticResource PageBg}"
             Title="Admins"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Admins" Style="{StaticResource HeaderTitle}" />
                    <Label Text="OWNER" Style="{StaticResource Pill}" />
                </HorizontalStackLayout>
                <Label Text="Owner-only account tools" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Generate Code For Other Admins" FontSize="16" FontAttributes="Bold" />
                        <Label x:Name="OwnerOnlyLabel" Style="{StaticResource SmallMuted}" LineBreakMode="WordWrap" />
                        <Button x:Name="GenerateCodeButton" Text="Generate New Admin Code" Style="{StaticResource PrimaryButton}" Clicked="OnGenerateCodeClicked" />
                        <Entry x:Name="GeneratedCodeEntry" Placeholder="Generated code appears here" IsReadOnly="True" Style="{StaticResource InputEntry}" />
                        <Label x:Name="ExpiryLabel" Style="{StaticResource SmallMuted}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Copy Code" Style="{StaticResource DarkButton}" Clicked="OnCopyCodeClicked" />
                            <Button Grid.Column="1" Text="Send Email" Style="{StaticResource OutlineButton}" Clicked="OnSendEmailClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Shop Admins" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="AdminListLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Promote Owner" Style="{StaticResource OutlineButton}" Clicked="OnPromoteOwnerClicked" />
                            <Button Grid.Column="1" Text="Deactivate" BackgroundColor="{StaticResource SoftRed}" TextColor="{StaticResource Red}" BorderColor="#FCA5A5" BorderWidth="1" CornerRadius="14" Clicked="OnDeactivateClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMessagesClicked" />
            <Button Grid.Column="2" Text="Reports" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnReportsClicked" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
