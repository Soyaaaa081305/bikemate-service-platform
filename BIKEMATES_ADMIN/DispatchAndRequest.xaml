<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.DispatchAndRequest"
             BackgroundColor="{StaticResource PageBg}"
             Title="Dispatch and Request"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Dispatch and Request" Style="{StaticResource HeaderTitle}" />
                <Label Text="Assign mechanics to customer jobs" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Label Text="Mechanic Status Legend" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource Green}" VerticalOptions="Center" />
                            <Label Text="Green - Available" Style="{StaticResource SmallMuted}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource Red}" VerticalOptions="Center" />
                            <Label Text="Red - Unavailable" Style="{StaticResource SmallMuted}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource Orange}" VerticalOptions="Center" />
                            <Label Text="Orange - Dispatched" Style="{StaticResource SmallMuted}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" BackgroundColor="{StaticResource Yellow}" VerticalOptions="Center" />
                            <Label Text="Yellow - Arrived" Style="{StaticResource SmallMuted}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Customer Request" FontSize="18" FontAttributes="Bold" />
                        <Picker x:Name="RequestPicker" Title="Select request" SelectedIndexChanged="OnRequestSelected" />
                        <Label x:Name="RequestDetailsLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                        <Picker x:Name="MechanicPicker" Title="Available mechanic" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Accept" Style="{StaticResource PrimaryButton}" Clicked="OnAcceptClicked" />
                            <Button Grid.Column="1" Text="Assign" Style="{StaticResource DarkButton}" Clicked="OnAssignClicked" />
                        </Grid>
                        <Button Text="View Mechanic Map and Request Details" Style="{StaticResource OutlineButton}" Clicked="OnViewMapClicked" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Mechanic Status List" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" BackgroundColor="{StaticResource Green}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Jose Reyes" Style="{StaticResource ItemTitle}" />
                                <Label Text="Available for new request" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="GREEN" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Green}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineColor}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" BackgroundColor="{StaticResource Red}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Ramon Lee" Style="{StaticResource ItemTitle}" />
                                <Label Text="Unavailable / off duty" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="RED" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Red}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineColor}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" BackgroundColor="{StaticResource Orange}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Marco Cruz" Style="{StaticResource ItemTitle}" />
                                <Label Text="Currently being dispatched" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="ORANGE" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Orange}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineColor}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="0,8">
                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="6" BackgroundColor="{StaticResource Yellow}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Alex Lim" Style="{StaticResource ItemTitle}" />
                                <Label Text="Arrived at destination" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="YELLOW" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Yellow}" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dispatch Status" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="RequestStatusLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Message Customer" Style="{StaticResource OutlineButton}" Clicked="OnMessageCustomerClicked" />
                            <Button Grid.Column="1" Text="Refresh" Style="{StaticResource OutlineButton}" Clicked="OnRefreshClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Calendar" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnCalendarClicked" />
            <Button Grid.Column="2" Text="Operations" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnOperationsClicked" />
            <Button Grid.Column="3" Text="Dispatch" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
        </Grid>
    </Grid>
</ContentPage>
