<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.AccCreate0"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="#242424" StrokeThickness="0" Padding="20,24,20,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="Create an Account" FontSize="22" FontAttributes="Bold" TextColor="White" />
                <Label Text="Step 1 of 5 - Account credentials" FontSize="13" TextColor="#E6E6E6" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,22" Spacing="14">
                <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="13">
                        <Label Text="Account credentials" FontSize="18" FontAttributes="Bold" TextColor="#242424" />
                        <Label Text="Use the email and password you will use to access the shop admin side." FontSize="13" TextColor="#6E6E6E" />

                        <Label Text="Phone number *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="PhoneEntry" Placeholder="Phone number" Keyboard="Telephone" />
                        </Border>

                        <Label Text="Email *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Placeholder="admin@example.com" Keyboard="Email" />
                        </Border>

                        <Label Text="Password *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
                        </Border>

                        <Label Text="Confirm password *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="ConfirmPasswordEntry" Placeholder="Confirm password" IsPassword="True" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="Continue" BackgroundColor="#FF6B2C" TextColor="White"
                FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Margin="20,10,20,24"
                Clicked="OnContinueClicked" />
    </Grid>
</ContentPage>
