<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.DispatchMapDetails"
             BackgroundColor="{StaticResource PageBg}"
             Title="Dispatch Map Details"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Dispatch Map Details" Style="{StaticResource HeaderTitle}" />
                <Label Text="Mechanic location and request details" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Label Grid.Column="2" Text="MAP" Style="{StaticResource Pill}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}" Padding="0" HeightRequest="230" BackgroundColor="{StaticResource SoftBlue}" BorderColor="{StaticResource LineColor}">
                    <Grid>
                        <BoxView Rotation="28" HeightRequest="26" WidthRequest="430" BackgroundColor="White" Opacity="0.9" HorizontalOptions="Center" VerticalOptions="Center" />
                        <BoxView Rotation="-35" HeightRequest="22" WidthRequest="320" BackgroundColor="White" Opacity="0.9" HorizontalOptions="Center" VerticalOptions="Center" TranslationY="36" />
                        <Frame WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0" BackgroundColor="White" BorderColor="{StaticResource Orange}" HorizontalOptions="Start" VerticalOptions="Center" Margin="88,0,0,0">
                            <Label Text="MC" FontAttributes="Bold" TextColor="{StaticResource Orange}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Frame WidthRequest="42" HeightRequest="42" CornerRadius="21" Padding="0" BackgroundColor="White" BorderColor="{StaticResource Blue}" HorizontalOptions="End" VerticalOptions="Start" Margin="0,56,56,0">
                            <Label Text="C" FontAttributes="Bold" TextColor="{StaticResource Blue}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <Label Text="Mock Google Map Area - API/location DB ready"
                               BackgroundColor="#CC0D1B2A"
                               TextColor="White"
                               Padding="10,6"
                               FontSize="10"
                               HorizontalOptions="Start"
                               VerticalOptions="End"
                               Margin="14" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Marco Cruz" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Orange - currently being dispatched" TextColor="{StaticResource Orange}" FontAttributes="Bold" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="68%" Style="{StaticResource Pill}" BackgroundColor="{StaticResource Orange}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="0.68" ProgressColor="{StaticResource Orange}" />
                        <Label Text="ETA: 12 minutes - Distance: 3.4 km" Style="{StaticResource SmallMuted}" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Customer Request Details" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,8">
                            <Label Text="CU" WidthRequest="34" HeightRequest="34" FontSize="11" FontAttributes="Bold" TextColor="White" BackgroundColor="{StaticResource Blue}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Maria Santos" Style="{StaticResource ItemTitle}" />
                                <Label Text="Customer" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineColor}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,8">
                            <Label Text="PIN" WidthRequest="34" HeightRequest="34" FontSize="10" FontAttributes="Bold" TextColor="White" BackgroundColor="{StaticResource Orange}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Las Pinas City" Style="{StaticResource ItemTitle}" />
                                <Label Text="Destination address from database location fields" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource LineColor}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,8">
                            <Label Text="JOB" WidthRequest="34" HeightRequest="34" FontSize="10" FontAttributes="Bold" TextColor="White" BackgroundColor="{StaticResource Green}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Full Tune-up" Style="{StaticResource ItemTitle}" />
                                <Label Text="Gear shifting issue and brake check" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Call Mechanic" Style="{StaticResource PrimaryButton}" Clicked="OnCallMechanicClicked" />
                    <Button Grid.Column="1" Text="Open Request" Style="{StaticResource OutlineButton}" Clicked="OnOpenRequestClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Back" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnBackClicked" />
            <Button Grid.Column="1" Text="Dispatch" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" Clicked="OnBackClicked" />
            <Button Grid.Column="2" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMessagesClicked" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
