<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Settings"
             BackgroundColor="{StaticResource PageBg}"
             Title="Settings"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Settings" Style="{StaticResource HeaderTitle}" />
                <Label Text="Admin app preferences" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Notifications" FontSize="18" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Push alerts" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="PushAlertsSwitch" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Daily email reports" TextColor="{StaticResource TextDark}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" x:Name="DailyReportsSwitch" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Shop Defaults" FontSize="18" FontAttributes="Bold" />
                        <Entry x:Name="DefaultCityEntry" Placeholder="Default city" Style="{StaticResource InputEntry}" />
                        <Entry x:Name="ContactNumberEntry" Placeholder="Shop contact number" Keyboard="Telephone" Style="{StaticResource InputEntry}" />
                        <Button Text="Save Settings" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Help" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHelpClicked" />
            <Button Grid.Column="2" Text="Settings" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="3" Text="Sign Out" BackgroundColor="Transparent" TextColor="{StaticResource Red}" FontSize="11" Clicked="OnSignOutClicked" />
        </Grid>
    </Grid>
</ContentPage>
