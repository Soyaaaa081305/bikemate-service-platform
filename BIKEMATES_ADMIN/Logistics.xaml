<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Logistics"
             BackgroundColor="{StaticResource PageBg}"
             Title="Logistics"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Logistics" Style="{StaticResource HeaderTitle}" />
                <Label Text="Sales, payments, orders, and stock flow" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Label Text="Sales Summary" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Frame Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout>
                            <Label x:Name="RevenueLabel" FontSize="21" FontAttributes="Bold" />
                            <Label Text="Monthly Revenue" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout>
                            <Label x:Name="OrdersLabel" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                            <Label Text="Completed Orders" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout>
                            <Label Text="7" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                            <Label Text="Pending Payments" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout>
                            <Label Text="PHP 4,250" FontSize="21" FontAttributes="Bold" TextColor="{StaticResource Blue}" />
                            <Label Text="Today" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Label Text="PayMongo Payment Flow" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftGreen}" BorderColor="Transparent">
                            <Label Text="PAY" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Paid Checkout #0042" Style="{StaticResource ItemTitle}" />
                            <Label Text="Juan dela Cruz - PHP 850" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Paid" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftOrange}" BorderColor="Transparent">
                            <Label Text="PEN" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Checkout #0043 waiting" Style="{StaticResource ItemTitle}" />
                            <Label Text="Maria Reyes - PHP 1,250" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="Pending" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Label Text="Inventory Movement" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="PaymentStatusLabel" Text="PayMongo status: ready" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout>
                                <Label Text="18" FontSize="22" FontAttributes="Bold" />
                                <Label Text="Sold" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="11" FontSize="22" FontAttributes="Bold" />
                                <Label Text="Restocked" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2">
                                <Label Text="4" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                                <Label Text="Low" Style="{StaticResource SmallMuted}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Label Text="Actions" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Refresh" Style="{StaticResource PrimaryButton}" Clicked="OnRefreshClicked" />
                    <Button Grid.Column="1" Text="Export Sales" Style="{StaticResource OutlineButton}" Clicked="OnExportClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" />
            <Button Grid.Column="2" Text="Profile" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
