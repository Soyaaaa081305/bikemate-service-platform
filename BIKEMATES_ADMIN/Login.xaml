<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.Login"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20,30,20,28" Spacing="18">
            <VerticalStackLayout Spacing="8">
                <Image Source="bikemate_logo" HeightRequest="88" HorizontalOptions="Center" />
                <Label Text="BIKEMATES ADMIN"
                       FontFamily="Inter"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#242424"
                       HorizontalTextAlignment="Center" />
                <Label Text="Manage your BikeMate partner shop after admin approval."
                       FontSize="13"
                       TextColor="#6E6E6E"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Shop admin sign in"
                               FontFamily="Inter"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#242424" />
                        <Label Text="Sign in with an approved shop-admin account."
                               FontSize="13"
                               TextColor="#6E6E6E" />
                    </VerticalStackLayout>

                    <Border x:Name="PendingApplicationPanel"
                            IsVisible="False"
                            BackgroundColor="#FFF7F2"
                            Stroke="#FFD1BD"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Application under review"
                                   FontFamily="Inter"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#7A3A12" />
                            <Label x:Name="PendingApplicationLabel"
                                   Text="Your submitted shop-admin application is saved on this device."
                                   FontSize="11"
                                   TextColor="#7A3A12" />
                            <Button Text="View submitted application"
                                    BackgroundColor="White"
                                    TextColor="#242424"
                                    BorderColor="#FFD1BD"
                                    BorderWidth="1"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="42"
                                    Clicked="OnViewPendingApplicationClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Email address" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="EmailEntry"
                                   Placeholder="name@example.com"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   TextChanged="OnEmailChanged"
                                   TextColor="#242424"
                                   PlaceholderColor="#6E6E6E" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Enter your password"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   TextColor="#242424"
                                   PlaceholderColor="#6E6E6E" />
                        </Border>
                        <Button Text="Forgot password?"
                                BackgroundColor="Transparent"
                                TextColor="#FF6B00"
                                FontAttributes="Bold"
                                HorizontalOptions="End"
                                HeightRequest="34"
                                MinimumHeightRequest="34"
                                Padding="0"
                                Clicked="OnForgotPasswordClicked" />
                    </VerticalStackLayout>

                    <Button x:Name="LoginButton"
                            Text="Sign in"
                            BackgroundColor="#FF6B00"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="48"
                            Clicked="OnLoginClicked" />

                    <Label Text="New partner shop? Submit your shop-admin application for BikeMate review."
                           FontSize="13"
                           TextColor="#6E6E6E"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Apply as Shop Admin"
                            BackgroundColor="White"
                            TextColor="#242424"
                            BorderColor="#DADCE0"
                            BorderWidth="1"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="48"
                            Clicked="OnCreateAccountClicked" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


