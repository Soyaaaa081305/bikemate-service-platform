<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Main.MainPage"
             BackgroundColor="{StaticResource PageBg}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Grid.Row="0" BackgroundColor="{StaticResource Navy}" Padding="18,16,18,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>

            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="8">
                    <Label x:Name="WelcomeLabel" Text="Welcome Admin" Style="{StaticResource HeaderTitle}" />
                    <Label Text="ADMIN" Style="{StaticResource Pill}" />
                </HorizontalStackLayout>
                <Label x:Name="AssignedShopLabel" Text="Assigned Bikeshop" Style="{StaticResource HeaderSubtitle}" />
                <Label x:Name="HeaderShopNameLabel" Text="Assigned Bikeshop" IsVisible="False" />
            </VerticalStackLayout>

            <Frame Grid.Column="2" WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="#223145" BorderColor="#2D3D52">
                <Label Text="!" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
            </Frame>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}" BackgroundColor="#111F33" BorderColor="#111F33">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Today's Revenue" TextColor="#B8C0CC" FontSize="11" />
                            <Label Text="PHP 4,250.00" FontSize="26" FontAttributes="Bold" TextColor="White" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                            <Label Text="+12%" TextColor="{StaticResource Green}" FontAttributes="Bold" FontSize="12" />
                            <Label Text="vs yesterday" TextColor="#B8C0CC" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Label Text="Today's Summary" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Frame Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="5" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                            <Label Text="Pending Orders" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="3" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Blue}" />
                            <Label Text="Active Dispatches" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Style="{StaticResource SmallCardFrame}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="2" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                            <Label Text="Bookings Today" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Row="1" Grid.Column="1" Style="{StaticResource SmallCardFrame}" BorderColor="#FCA5A5">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="4" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Red}" />
                            <Label Text="Low Stock Items" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Label Text="Mechanic Status" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource CardFrame}">
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="16">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Frame WidthRequest="44" HeightRequest="44" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftBlue}" BorderColor="Transparent">
                                    <Label Text="JR" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                </Frame>
                                <Label Text="Jose" FontSize="10" HorizontalTextAlignment="Center" />
                                <Label Text="Free" FontSize="10" TextColor="{StaticResource Green}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Frame WidthRequest="44" HeightRequest="44" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftYellow}" BorderColor="Transparent">
                                    <Label Text="MC" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                </Frame>
                                <Label Text="Marco" FontSize="10" HorizontalTextAlignment="Center" />
                                <Label Text="On Job" FontSize="10" TextColor="{StaticResource Orange}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Frame WidthRequest="44" HeightRequest="44" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftViolet}" BorderColor="Transparent">
                                    <Label Text="AL" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                </Frame>
                                <Label Text="Alex" FontSize="10" HorizontalTextAlignment="Center" />
                                <Label Text="On Job" FontSize="10" TextColor="{StaticResource Orange}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Frame WidthRequest="44" HeightRequest="44" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="#F3F4F6" BorderColor="Transparent">
                                    <Label Text="RL" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                                </Frame>
                                <Label Text="Ramon" FontSize="10" HorizontalTextAlignment="Center" />
                                <Label Text="Off" FontSize="10" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>
                </Frame>

                <Label Text="Quick Actions" Style="{StaticResource SectionLabel}" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Button Text="+ New Product" Style="{StaticResource DarkButton}" Clicked="OnNewProductClicked" />
                    <Button Grid.Column="1" Text="Dispatch Now" Style="{StaticResource PrimaryButton}" Clicked="OnDispatchClicked" />
                    <Button Grid.Row="1" Text="Menu" Style="{StaticResource OutlineButton}" Clicked="OnMenuClicked" />
                    <Button Grid.Row="1" Grid.Column="1" Text="Messages" Style="{StaticResource OutlineButton}" Clicked="OnMessagesClicked" />
                </Grid>

                <Label Text="Pending Requests" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftOrange}" BorderColor="Transparent">
                            <Label Text="REQ" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Orange}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Juan dela Cruz" Style="{StaticResource ItemTitle}" />
                            <Label Text="Brake repair - Paranaque" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="URGENT" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftBlue}" BorderColor="Transparent">
                            <Label Text="JOB" HorizontalOptions="Center" VerticalOptions="Center" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Blue}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Maria Santos" Style="{StaticResource ItemTitle}" />
                            <Label Text="Full tune-up - Las Pinas" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="TODAY" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>

                <Label Text="Recent Activity" Style="{StaticResource SectionLabel}" />
                <Frame Style="{StaticResource SmallCardFrame}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame WidthRequest="38" HeightRequest="38" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{StaticResource SoftGreen}" BorderColor="Transparent">
                            <Label Text="OK" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Green}" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="New order #0042 received" Style="{StaticResource ItemTitle}" />
                            <Label Text="Shimano chain - PHP 850" Style="{StaticResource SmallMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="2m" Style="{StaticResource Pill}" VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Messages" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMessagesClicked" />
            <Button Grid.Column="2" Text="Profile" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnProfileClicked" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
