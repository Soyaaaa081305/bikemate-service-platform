<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Calendar"
             BackgroundColor="{StaticResource PageBg}"
             Title="Calendar"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource PageBg}">
        <Grid Padding="18,16,18,18" BackgroundColor="{StaticResource Navy}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Frame WidthRequest="48" HeightRequest="48" CornerRadius="14" Padding="0" HasShadow="False" BackgroundColor="{StaticResource Orange}" BorderColor="{StaticResource Orange}">
                <Image Source="bikemate_logo.png" HeightRequest="34" WidthRequest="34" HorizontalOptions="Center" VerticalOptions="Center" />
            </Frame>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Calendar" Style="{StaticResource HeaderTitle}" />
                <Label Text="Bookings and shop schedule" Style="{StaticResource HeaderSubtitle}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="Menu" WidthRequest="54" HeightRequest="38" Padding="0" BackgroundColor="#223145" TextColor="White" CornerRadius="12" Clicked="OnMenuClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14" Spacing="12">
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Schedule" FontSize="18" FontAttributes="Bold" />
                        <DatePicker x:Name="ScheduleDatePicker" DateSelected="OnDateSelected" />
                        <Entry x:Name="BookingTitleEntry" Placeholder="Booking or operation title" Style="{StaticResource InputEntry}" />
                        <Picker x:Name="MechanicPicker" Title="Assign mechanic" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Add Schedule" Style="{StaticResource PrimaryButton}" Clicked="OnAddScheduleClicked" />
                            <Button Grid.Column="1" Text="Today" Style="{StaticResource DarkButton}" Clicked="OnTodayClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="SelectedDateLabel" Text="Today" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="ScheduleListLabel" TextColor="{StaticResource MutedText}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" BackgroundColor="White" Padding="0,7,0,12" ColumnDefinitions="*,*,*,*" HeightRequest="64">
            <Button Text="Home" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnHomeClicked" />
            <Button Grid.Column="1" Text="Dispatch" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnDispatchClicked" />
            <Button Grid.Column="2" Text="Calendar" BackgroundColor="Transparent" TextColor="{StaticResource Orange}" FontSize="11" FontAttributes="Bold" />
            <Button Grid.Column="3" Text="Menu" BackgroundColor="Transparent" TextColor="#6B7280" FontSize="11" Clicked="OnMenuClicked" />
        </Grid>
    </Grid>
</ContentPage>
