<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Account.AccCreate4"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="#242424" StrokeThickness="0" Padding="20,24,20,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="Create an Account" FontSize="22" FontAttributes="Bold" TextColor="White" />
                <Label Text="Step 5 of 5 - Admin access code" FontSize="13" TextColor="#E6E6E6" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,28" Spacing="14">
                <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="18">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Enter account creation code"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#242424" />
                        <Label Text="Use the code generated when the bike shop was registered."
                               FontSize="13"
                               TextColor="#6E6E6E" />
                        <Label Text="Access code *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#FFB37A" BackgroundColor="#FFF3EA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="AccessCodeEntry"
                                   Placeholder="ABCD-1234"
                                   TextColor="#242424"
                                   PlaceholderColor="#6E6E6E" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="CreateAccountButton"
                Grid.Row="2"
                Text="Create Account"
                BackgroundColor="#FF6B2C"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Margin="20,10,20,24"
                Clicked="OnCreateAccountClicked" />
    </Grid>
</ContentPage>
