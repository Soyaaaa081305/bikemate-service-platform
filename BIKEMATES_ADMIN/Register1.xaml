<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BIKEMATES_ADMIN.Pages.Register.Register1"
             BackgroundColor="#F6F6F6">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" BackgroundColor="#242424" StrokeThickness="0" Padding="20,24,20,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="Shop Validation" FontSize="22" FontAttributes="Bold" TextColor="White" />
                <Label Text="Step 2 of 2 - Business requirements" FontSize="13" TextColor="#E6E6E6" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,22" Spacing="14">
                <Border BackgroundColor="White" Stroke="#E6E6E6" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Verify your shop"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#242424" />
                        <Label Text="Upload the business permit, shop image, and DTI registration number."
                               FontSize="13"
                               TextColor="#6E6E6E" />

                        <Label Text="Business permit *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label x:Name="BusinessPermitLabel" Text="No file selected" VerticalOptions="Center" TextColor="#6E6E6E" />
                                <Button Grid.Column="1" Text="Upload" BackgroundColor="#FF6B2C" TextColor="White" CornerRadius="8" Clicked="OnPickPermitClicked" />
                            </Grid>
                        </Border>

                        <Label Text="Shop image *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,8">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label x:Name="ShopImageLabel" Text="No file selected" VerticalOptions="Center" TextColor="#6E6E6E" />
                                <Button Grid.Column="1" Text="Upload" BackgroundColor="#FF6B2C" TextColor="White" CornerRadius="8" Clicked="OnPickShopImageClicked" />
                            </Grid>
                        </Border>

                        <Label Text="DTI registration number *" FontSize="11" FontAttributes="Bold" TextColor="#242424" />
                        <Border Stroke="#DCDCDC" BackgroundColor="#FAFAFA" Padding="12,2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Entry x:Name="DtiEntry" Placeholder="DTI registration number" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="FinishButton"
                Grid.Row="2"
                Text="Register Bike Shop"
                BackgroundColor="#FF6B2C"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="50"
                Margin="20,10,20,24"
                Clicked="OnFinishClicked" />
    </Grid>
</ContentPage>
